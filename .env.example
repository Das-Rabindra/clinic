# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8090
# 32+ random chars. Generate: openssl rand -hex 32
# Encrypts integration secrets at rest and signs OAuth state. REQUIRED.
APP_SECRET=
# Public origin, used for canonical/OG URLs and OAuth redirects.
# On Vercel this can be left unset: the app derives it from the deployment's
# own hostname. Set it explicitly once a custom domain is attached.
PUBLIC_URL=http://localhost:8090
TRUST_PROXY=false

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# Local docker:  postgres://clinic:<password>@localhost:5432/clinic
# Neon/Vercel:   set automatically by the Postgres integration
DATABASE_URL=
# Only used by docker compose, which builds DATABASE_URL from it.
POSTGRES_PASSWORD=

# ─── Storage ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
# local | blob   (defaults to blob on Vercel, whose filesystem is ephemeral)
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
MAX_UPLOAD_MB=10

# ─── Serverless cron (Vercel) ────────────────────────────────────────────────
# Protects /api/cron. Vercel Cron sends it as a Bearer token automatically.
# Optional on Vercel — with no secret set, only Vercel's own scheduler is
# accepted and every other caller gets a 401. Required for an external pinger.
CRON_SECRET=

# ─── First admin (created on first boot only, then ignored) ──────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── WhatsApp Cloud API  (Meta) ──────────────────────────────────────────────
# Leave blank -> notifications are recorded as "not configured", never faked.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Approved template names (Meta requires pre-approved templates for outbound)
WHATSAPP_USE_TEMPLATES=true
WHATSAPP_TEMPLATE_LANG=en

# ─── Google Business Profile (reviews) ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI to register in Google Cloud console:
#   <PUBLIC_URL>/oauth/google/callback

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Samal Dental Care <noreply@example.com>"

# ─── Background jobs ─────────────────────────────────────────────────────────
RUN_JOBS=true
JOB_POLL_MS=20000
REMINDER_24H=true
REMINDER_2H=true
