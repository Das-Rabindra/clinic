<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body class="has-action-bar">
<% var ic = function (n) { return include('partials/icon', { name: n }); }; %>
<a class="skip-to-content" href="#main">Skip to content</a>
<%- include('partials/site-header') %>

<main id="main">
  <section class="page-cine page-cine--photo" data-hero aria-labelledby="pageTitle">
    <%- include('partials/scene-photo', { photo: scenePhoto, flip: true, position: '50% 55%' }) %>
    <div class="container">
      <div class="page-cine__inner">
        <p class="eyebrow-label">Page not found</p>
        <h1 id="pageTitle">That page isn&rsquo;t <em class="display-em">here</em></h1>
        <p class="page-cine__lede">The link may be out of date, or the address mistyped. Everything the clinic offers is still one tap away.</p>
        <div class="page-cine__actions">
          <a href="/services" class="button button--inverse">See all treatments</a>
          <% if (clinic.phone) { %><a href="tel:<%= clinic.phone_intl || clinic.phone %>" class="button button--ghost-light" data-track="call_clicked"><%- ic('phone') %>Call <%= clinic.phone %></a><% } %>
          <% if (whatsappUrl) { %><a href="<%= whatsappUrl %>" target="_blank" rel="noopener" class="button button--ghost-light" data-track="whatsapp_clicked"><%- ic('whatsapp') %>WhatsApp</a><% } %>
        </div>
      </div>
    </div>
    <p class="page-cine__credit">Illustrative photograph</p>
  </section>

  <section class="section" aria-labelledby="popularTitle">
    <div class="container">
      <div class="index-head" data-reveal>
        <h2 id="popularTitle">Treatments patients look for most</h2>
      </div>
      <div class="treatments-rows treatments-rows--flush">
        <% footerServices.forEach(function (s, i) { %><%- include('partials/treatment-card', { s: s, variant: 'row', index: i }) %><% }) %>
      </div>
      <p class="section-foot"><a class="button button--secondary" href="/">Back to the homepage</a></p>
    </div>
  </section>
</main>

<%- include('partials/site-footer') %>
<script src="/js/ds.js" defer></script>
<script src="/js/site-ds.js" defer></script>
<script src="/js/motion.js" defer></script>
</body>
</html>
