<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body class="has-action-bar">
<% var ic = function (n) { return include('partials/icon', { name: n }); }; %>
<a class="skip-to-content" href="#main">Skip to content</a>
<%- include('partials/site-header') %>

<main id="main">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow-label">Page not found</span>
      <h1>That page isn&rsquo;t here</h1>
      <p class="page-hero__lede">The link may be out of date, or the address mistyped. Everything the clinic offers is still one tap away.</p>
      <div class="cluster page-hero__actions">
        <a href="/services" class="button button--primary">See all treatments</a>
        <% if (clinic.phone) { %><a href="tel:<%= clinic.phone_intl || clinic.phone %>" class="button button--secondary" data-track="call_clicked"><%- ic('phone') %>Call <%= clinic.phone %></a><% } %>
        <% if (whatsappUrl) { %><a href="<%= whatsappUrl %>" target="_blank" rel="noopener" class="button button--secondary" data-track="whatsapp_clicked"><%- ic('whatsapp') %>WhatsApp</a><% } %>
      </div>
    </div>
  </section>

  <section class="section section--tight-top" aria-labelledby="popularTitle">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow-label">Popular</span>
        <h2 id="popularTitle">Treatments patients look for most</h2>
      </div>
      <div class="treatment-grid">
        <% footerServices.forEach(function (s) { %><%- include('partials/treatment-card', { s: s }) %><% }) %>
      </div>
      <p class="section-foot"><a class="button button--secondary" href="/">Back to the homepage</a></p>
    </div>
  </section>
</main>

<%- include('partials/site-footer') %>
<script src="/js/ds.js" defer></script>
<script src="/js/site-ds.js" defer></script>
<script src="/js/motion.js" defer></script>
</body>
</html>
