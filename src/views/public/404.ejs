<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<%- include('partials/header') %>

<main id="main">
  <section class="tx-index-hero">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>That page isn’t here</h1>
      <svg class="smile-arc" viewBox="0 0 64 16"><path d="M4 4 Q32 18 60 4"/></svg>
      <p class="tx-index-lede">The link may be out of date, or the address mistyped. Everything the clinic offers is still one tap away.</p>
      <div class="hero-ctas" style="margin-top:26px;">
        <a href="/services" class="btn btn-primary">See all treatments</a>
        <% if (clinic.phone) { %>
        <a href="tel:<%= clinic.phone_intl || clinic.phone %>" class="btn btn-outline-dark" data-track="call_clicked">
          Call <%= clinic.phone %>
        </a>
        <% } %>
        <% if (whatsappUrl) { %>
        <a href="<%= whatsappUrl %>" target="_blank" rel="noopener" class="btn btn-whatsapp" data-track="whatsapp_clicked">WhatsApp</a>
        <% } %>
      </div>
    </div>
  </section>

  <section class="section-pad" style="padding-top:0;">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Popular</span>
        <h2 class="section-title">Treatments patients look for most</h2>
      </div>
      <%- include('partials/treatment-grid', { cards: footerServices }) %>
      <div class="tx-index-foot"><a class="btn btn-outline-dark" href="/">Back to the homepage</a></div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<script src="/js/site.js" defer></script>
</body>
</html>
