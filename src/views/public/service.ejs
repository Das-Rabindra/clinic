<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body class="has-action-bar">
<% var ic = function (n) { return include('partials/icon', { name: n }); }; %>
<% var tel = clinic.phone ? 'tel:' + (clinic.phone_intl || clinic.phone) : null; %>
<% var bookHref = '/#appointment' + (service.bookable ? '?treatment=' + service.slug : ''); %>
<a class="skip-to-content" href="#main">Skip to content</a>
<%- include('partials/site-header') %>

<main id="main">

  <!-- ============ TREATMENT HERO ============ -->
  <section class="page-hero page-hero--split">
    <div class="container">
      <%- include('partials/breadcrumbs', { trail: [{ name: 'Home', href: '/' }, { name: 'Treatments', href: '/services' }, { name: service.name }] }) %>
      <div class="tx-hero">
        <div class="tx-hero__copy">
          <% if (service.category_name) { %><span class="eyebrow-label"><%= service.category_name %></span><% } %>
          <h1><%= service.name %></h1>
          <% if (service.short_desc) { %><p class="page-hero__lede"><%= service.short_desc %></p><% } %>
          <ul class="tx-facts">
            <li><%- ic('clock') %><span>Appointment of about <%= service.duration_min %> minutes</span></li>
            <%# The clinic does not publish prices. The admin fields remain so
                that decision can be reversed, but nothing renders one. %>
            <li><%- ic('pin') %><span><%= shortAddress %></span></li>
          </ul>
          <div class="cluster page-hero__actions">
            <a href="<%= bookHref %>" class="button button--primary" data-track="appointment_started"><%- ic('calendar') %><%= service.bookable ? 'Book ' + service.name : 'Book a consultation' %></a>
            <% if (tel) { %><a href="<%= tel %>" class="button button--secondary" data-track="call_clicked"><%- ic('phone') %>Call</a><% } %>
            <% if (whatsappUrl) { %><a href="<%= treatmentWhatsapp %>" target="_blank" rel="noopener" class="button button--secondary" data-track="whatsapp_clicked"><%- ic('whatsapp') %>Ask on WhatsApp</a><% } %>
          </div>
        </div>
        <figure class="tx-hero__media">
          <% if (service.image_url) { %>
            <img src="<%= service.image_url %>" alt="<%= service.image_alt || '' %>"
                 width="<%= service.image_width || 1280 %>" height="<%= service.image_height || 720 %>"
                 fetchpriority="high" decoding="async">
            <%# Said plainly where the photograph is largest. A licensed image
                presented without this reads as the clinic's own work. %>
            <% if (service.image_is_stock) { %><figcaption>Illustrative image, not a photograph of the clinic</figcaption><% } %>
          <% } else { %>
            <div class="treatment-card__art"><%- include('partials/treatment-art', { slug: service.slug, name: service.name }) %></div>
          <% } %>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ DETAIL ============ -->
  <section class="section">
    <div class="container tx-detail">
      <article class="tx-detail__main prose">
        <% if (service.long_desc) { %>
        <h2>What it is</h2>
        <p><%= service.long_desc %></p>
        <% } %>

        <% if (service.who_needs) { %>
        <h2>When it may be needed</h2>
        <p><%= service.who_needs %></p>
        <% } %>

        <% if (service.what_to_expect) { %>
        <h2>What the treatment generally involves</h2>
        <p><%= service.what_to_expect %></p>
        <% } %>

        <% if (benefits.length) { %>
        <h2>What it aims to do</h2>
        <ul class="tx-benefits">
          <% benefits.forEach(function (b) { %><li><%- ic('check') %><span><%= b %></span></li><% }) %>
        </ul>
        <% } %>

        <h2>What a consultation helps decide</h2>
        <div class="notice notice--info">
          <span class="notice__icon"><%- ic('info') %></span>
          <div class="notice__body">
            <p>This page explains the treatment in general terms. Whether it is right for you depends on an examination:
            <%= clinic.doctor || 'the dentist' %> will look at your teeth and gums, explain what is found, and go through the options with you before anything is decided.</p>
          </div>
        </div>
      </article>

      <%# Sticky contact card: the dentist, where, today's status and the ways to act.
          Not a bento — this is the one aside the detail body has. %>
      <aside class="tx-aside" aria-labelledby="asideTitle">
        <div class="card tx-aside__card">
          <div class="card__body">
            <h2 class="visually-hidden-ds" id="asideTitle">Book or ask about <%= service.name %></h2>
            <div class="tx-aside__doctor">
              <% if (doctorPhoto) { %>
                <img src="<%= doctorPhoto.url %>" alt="" width="56" height="56" loading="lazy" decoding="async">
              <% } %>
              <div>
                <strong><%= clinic.doctor %></strong>
                <span class="text-small text-muted"><%= clinic.qualification %></span>
              </div>
            </div>
            <dl class="tx-aside__meta">
              <div><dt>Where</dt><dd><%= clinic.address %></dd></div>
              <div><dt>Today</dt><dd><span class="status-pill status-pill--<%= clinic.today.now.state %>"><span class="status-pill__dot" aria-hidden="true"></span><%= clinic.today.now.label %></span></dd></div>
            </dl>
            <div class="tx-aside__actions">
              <a href="<%= bookHref %>" class="button button--primary button--block" data-track="appointment_started"><%- ic('calendar') %>Book an appointment</a>
              <button type="button" class="button button--secondary button--block" data-callback-open data-service="<%= service.id %>" data-service-name="<%= service.name %>"><%- ic('callback') %>Request a call back</button>
              <% if (tel) { %><a href="<%= tel %>" class="button button--text button--block" data-track="call_clicked"><%- ic('phone') %>Call <%= clinic.phone %></a><% } %>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <% if (faqs.length) { %>
  <section class="section section--surface" id="faq">
    <div class="container container--narrow">
      <div class="section-heading">
        <span class="eyebrow-label">Good to know</span>
        <h2>Questions patients ask</h2>
      </div>
      <div class="accordion" data-accordion>
        <% faqs.forEach(function (f, i) { %>
        <div class="accordion__item">
          <h3 class="accordion__heading">
            <button type="button" class="accordion__trigger" aria-expanded="false" aria-controls="faq-a-<%= i %>" id="faq-q-<%= i %>">
              <%= f.question %><span class="accordion__icon"><%- ic('plus') %></span>
            </button>
          </h3>
          <div class="accordion__panel" id="faq-a-<%= i %>" role="region" aria-labelledby="faq-q-<%= i %>" data-collapsed>
            <p><%= f.answer %></p>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ============ RELATED ============ -->
  <% if (related.length) { %>
  <section class="section" aria-labelledby="relatedTitle">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow-label">Also at the clinic</span>
        <h2 id="relatedTitle">Related treatments</h2>
      </div>
      <div class="treatment-grid">
        <% related.forEach(function (s) { %><%- include('partials/treatment-card', { s: s }) %><% }) %>
      </div>
      <p class="section-foot"><a class="button button--secondary" href="/services">See all treatments</a></p>
    </div>
  </section>
  <% } else { %>
  <div class="container"><p class="section-foot"><a class="button button--secondary" href="/services">See all treatments</a></p></div>
  <% } %>

  <!-- ============ CTA ============ -->
  <section class="section section--primary cta">
    <div class="container cta__inner">
      <span class="eyebrow-label">Ready when you are</span>
      <h2>Talk to <%= clinic.doctor || 'the dentist' %> about <%= service.name.toLowerCase() %></h2>
      <p class="cta__body">Book online, or ask the clinic a question first &mdash; whichever you prefer.</p>
      <div class="cluster cta__actions">
        <a href="<%= bookHref %>" class="button button--inverse" data-track="appointment_started"><%- ic('calendar') %>Book an appointment</a>
        <% if (tel) { %><a href="<%= tel %>" class="button button--text cta__call" data-track="call_clicked"><%- ic('phone') %>Call <%= clinic.phone %></a><% } %>
      </div>
    </div>
  </section>

</main>

<%- include('partials/site-footer') %>
<script src="/js/ds.js" defer></script>
<script src="/js/site-ds.js" defer></script>
</body>
</html>
