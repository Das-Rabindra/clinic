<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<%- include('partials/header') %>

<main id="main">

  <!-- ============ TREATMENT HERO ============ -->
  <section class="tx-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/services">Treatments</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page"><%= service.name %></span>
      </nav>

      <div class="tx-hero-grid">
        <div>
          <% if (service.category_name) { %><span class="eyebrow"><%= service.category_name %></span><% } %>
          <h1><%= service.name %></h1>
          <svg class="smile-arc" viewBox="0 0 64 16"><path d="M4 4 Q32 18 60 4"/></svg>
          <% if (service.short_desc) { %><p class="tx-hero-lede"><%= service.short_desc %></p><% } %>

          <ul class="tx-facts">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              <span>About <%= service.duration_min %> minutes</span>
            </li>
            <% if (service.show_price && service.price_from) { %>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 4h12M6 9h12M9 4c4 0 6 2 6 5s-2 5-6 5h-3l8 6"/></svg>
              <span>From <%= service.currency === 'INR' ? '₹' : '' %><%= service.price_from %></span>
            </li>
            <% } %>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/><circle cx="12" cy="11" r="3"/></svg>
              <span><%= shortAddress %></span>
            </li>
          </ul>

          <div class="hero-ctas">
            <% if (service.bookable) { %>
            <a href="/#appointment?treatment=<%= service.slug %>" class="btn btn-primary book-service"
               data-service="<%= service.id %>" data-track="appointment_started">
              Book <%= service.name %>
            </a>
            <% } else { %>
            <a href="/#appointment" class="btn btn-primary">Book a consultation</a>
            <% } %>
            <% if (whatsappUrl) { %>
            <a href="<%= treatmentWhatsapp %>" target="_blank" rel="noopener" class="btn btn-whatsapp" data-track="whatsapp_clicked">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.6 1.4 5.1L2 22l5.1-1.3c1.4.8 3.1 1.3 4.9 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2zm5.9 14.2c-.2.7-1.4 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.1.2-.1.3-.3.5-.1.2-.3.4-.4.5-.1.1-.3.3-.1.6.2.3.9 1.5 1.9 2.4 1.3 1.2 2.4 1.5 2.7 1.7.3.2.5.1.7-.1.2-.2.8-.9 1-1.3.2-.3.4-.3.7-.2.3.1 1.8.9 2.1 1 .3.2.5.2.6.3.1.2.1.9-.1 1.6z"/></svg>
              Ask a question
            </a>
            <% } %>
          </div>
        </div>

        <div class="tx-hero-visual<%= service.image_url ? ' has-photo' : '' %>">
          <% if (service.image_url) { %>
            <img src="<%= service.image_url %>"
                 alt="<%= service.image_alt || (service.name + ' at ' + clinic.name) %>"
                 width="<%= service.image_width || 720 %>" height="<%= service.image_height || 540 %>"
                 fetchpriority="high" decoding="async">
          <% } else { %>
            <%- include('partials/treatment-art', { slug: service.slug, name: service.name }) %>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ DETAIL ============ -->
  <section class="section-pad">
    <div class="wrap tx-detail">
      <div class="tx-detail-main">
        <% if (service.long_desc) { %>
        <div class="tx-block reveal">
          <h2 class="section-title">What it is</h2>
          <p><%= service.long_desc %></p>
        </div>
        <% } %>

        <% if (service.who_needs) { %>
        <div class="tx-block reveal">
          <h2 class="section-title">When it may be needed</h2>
          <p><%= service.who_needs %></p>
        </div>
        <% } %>

        <% if (service.what_to_expect) { %>
        <div class="tx-block reveal">
          <h2 class="section-title">What to expect at your appointment</h2>
          <p><%= service.what_to_expect %></p>
        </div>
        <% } %>

        <% if (benefits.length) { %>
        <div class="tx-block reveal">
          <h2 class="section-title">What this treatment does for you</h2>
          <ul class="tx-benefits">
            <% benefits.forEach(function (b) { %>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              <span><%= b %></span>
            </li>
            <% }) %>
          </ul>
        </div>
        <% } %>

        <p class="tx-disclaimer reveal">
          This page explains the treatment in general terms. What is right for you depends on
          an examination — <%= clinic.doctor || 'the dentist' %> will go through the options
          with you before anything is decided.
        </p>
      </div>

      <%# Sticky side card: the doctor, the location and the two ways to act. %>
      <aside class="tx-aside">
        <div class="tx-aside-card">
          <div class="tx-aside-doctor">
            <% if (doctorPhoto) { %>
              <img src="<%= doctorPhoto.url %>" alt="<%= clinic.doctor %>" width="56" height="56" loading="lazy">
            <% } else { %>
              <span class="tx-aside-initials"><%= initials %></span>
            <% } %>
            <div>
              <strong><%= clinic.doctor %></strong>
              <span><%= clinic.qualification %></span>
            </div>
          </div>

          <dl class="tx-aside-meta">
            <div><dt>Clinic</dt><dd><%= clinic.name %></dd></div>
            <div><dt>Where</dt><dd><%= clinic.address %></dd></div>
            <div><dt>Today</dt><dd>
              <% if (clinic.today.is_open) { %>Open <%= clinic.today.open %> &ndash; <%= clinic.today.close %><% } else { %>Closed<% } %>
            </dd></div>
          </dl>

          <div class="tx-aside-actions">
            <a href="/#appointment?treatment=<%= service.slug %>" class="btn btn-primary btn-sm book-service"
               data-service="<%= service.id %>" data-track="appointment_started">Book an appointment</a>
            <button type="button" class="btn btn-outline-dark btn-sm" data-callback-open>Request a call back</button>
            <% if (clinic.phone) { %>
            <a href="tel:<%= clinic.phone_intl || clinic.phone %>" class="btn btn-outline-dark btn-sm mono" data-track="call_clicked"><%= clinic.phone %></a>
            <% } %>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <% if (faqs.length) { %>
  <section class="section-pad alt" id="faq">
    <div class="wrap">
      <div class="section-head reveal" style="text-align:center; margin-left:auto; margin-right:auto;">
        <span class="eyebrow">Good To Know</span>
        <h2 class="section-title" style="margin-left:auto; margin-right:auto;">Questions patients ask</h2>
      </div>
      <div class="faq-list reveal">
        <% faqs.forEach(function (f, i) { %>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false" aria-controls="faq-a-<%= i %>" id="faq-q-<%= i %>">
            <span><%= f.question %></span><span class="plus" aria-hidden="true"></span>
          </button>
          <div class="faq-a" id="faq-a-<%= i %>" role="region" aria-labelledby="faq-q-<%= i %>">
            <p><%= f.answer %></p>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ============ OTHER TREATMENTS ============ -->
  <% if (related.length) { %>
  <section class="section-pad">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Also At The Clinic</span>
        <h2 class="section-title">Other treatments</h2>
        <svg class="smile-arc" viewBox="0 0 64 16"><path d="M4 4 Q32 18 60 4"/></svg>
      </div>
      <div class="reveal">
        <%- include('partials/treatment-grid', { cards: related }) %>
      </div>
      <div class="tx-index-foot">
        <a class="btn btn-outline-dark" href="/services">See all treatments</a>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ============ CTA ============ -->
  <section class="cta-band">
    <div class="wrap">
      <span class="eyebrow" style="color:var(--honey);">Ready When You Are</span>
      <h2>Talk to <%= clinic.doctor || 'the dentist' %> about <%= service.name.toLowerCase() %></h2>
      <p>Book online in under a minute, or ask the clinic a question first — whichever you prefer.</p>
      <div class="hero-ctas">
        <a href="/#appointment?treatment=<%= service.slug %>" class="btn btn-primary book-service" data-service="<%= service.id %>">Book an Appointment</a>
        <% if (clinic.phone) { %><a href="tel:<%= clinic.phone_intl || clinic.phone %>" class="btn btn-outline" data-track="call_clicked">Call the Clinic</a><% } %>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<script src="/js/site.js" defer></script>
</body>
</html>
