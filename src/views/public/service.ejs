<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body class="has-action-bar">
<% var ic = function (n) { return include('partials/icon', { name: n }); }; %>
<% var tel = clinic.phone ? 'tel:' + (clinic.phone_intl || clinic.phone) : null; %>
<% var bookHref = '/book' + (service.bookable ? '?treatment=' + service.slug : ''); %>
<%# The body's chapters, numbered in the order they actually appear — a
    treatment without a "when it may be needed" text simply has one fewer. %>
<% var chapters = [];
   if (service.long_desc) chapters.push({ title: 'What it is', text: service.long_desc });
   if (service.who_needs) chapters.push({ title: 'When it may be needed', text: service.who_needs });
   if (service.what_to_expect) chapters.push({ title: 'What the treatment generally involves', text: service.what_to_expect });
   if (benefits.length) chapters.push({ title: 'What it aims to do', list: benefits });
   chapters.push({ title: 'What a consultation helps decide', consult: true }); %>
<a class="skip-to-content" href="#main">Skip to content</a>
<%- include('partials/site-header') %>

<main id="main">

  <!-- ============ SCENE ============ -->
  <%# The treatment's photograph behind the title, shaded where the type
      sits. A licensed image says so on the scene itself — presented without
      that, it reads as the clinic's own work. %>
  <section class="page-cine<%= service.image_url ? ' page-cine--photo' : '' %>" data-hero aria-labelledby="txTitle">
    <% if (service.image_url) { %>
    <div class="page-cine__media">
      <img src="<%= service.image_url %>" alt="<%= service.image_alt || '' %>"
           width="<%= service.image_width || 1280 %>" height="<%= service.image_height || 720 %>"
           fetchpriority="high" decoding="async">
    </div>
    <div class="page-cine__shade" aria-hidden="true"></div>
    <% } %>
    <div class="container">
      <div class="page-cine__inner">
        <%- include('partials/breadcrumbs', { trail: [{ name: 'Home', href: '/' }, { name: 'Treatments', href: '/services' }, { name: service.name }] }) %>
        <% if (service.category_name) { %><p class="eyebrow-label"><%= service.category_name %></p><% } %>
        <h1 id="txTitle"><%= service.name %></h1>
        <% if (service.short_desc) { %><p class="page-cine__lede"><%= service.short_desc %></p><% } %>
        <ul class="tx-facts">
          <li><%- ic('clock') %><span>Appointment of about <%= service.duration_min %> minutes</span></li>
          <%# The clinic does not publish prices. The admin fields remain so
              that decision can be reversed, but nothing renders one. %>
          <li><%- ic('pin') %><span><%= shortAddress %></span></li>
        </ul>
        <div class="page-cine__actions">
          <a href="<%= bookHref %>" class="button button--inverse" data-track="appointment_started"><%- ic('calendar') %><%= service.bookable ? 'Book ' + service.name : 'Book a consultation' %></a>
          <% if (tel) { %><a href="<%= tel %>" class="button button--ghost-light" data-track="call_clicked"><%- ic('phone') %>Call</a><% } %>
          <% if (whatsappUrl) { %><a href="<%= treatmentWhatsapp %>" target="_blank" rel="noopener" class="button button--ghost-light" data-track="whatsapp_clicked"><%- ic('whatsapp') %>Ask on WhatsApp</a><% } %>
        </div>
      </div>
    </div>
    <% if (service.image_url && service.image_is_stock) { %>
    <p class="page-cine__credit">Illustrative image, not a photograph of the clinic</p>
    <% } %>
  </section>

  <!-- ============ CHAPTERS ============ -->
  <section class="section">
    <div class="container tx-detail">
      <article class="tx-chapters">
        <% chapters.forEach(function (c, i) { %>
        <section class="tx-chapter" data-reveal aria-labelledby="txc-<%= i %>">
          <span class="tx-chapter__num" aria-hidden="true"><%= String(i + 1).padStart(2, '0') %></span>
          <h2 id="txc-<%= i %>"><%= c.title %></h2>
          <% if (c.text) { %><p><%= c.text %></p><% } %>
          <% if (c.list) { %>
          <ul class="tx-benefits">
            <% c.list.forEach(function (b) { %><li><%- ic('check') %><span><%= b %></span></li><% }) %>
          </ul>
          <% } %>
          <% if (c.consult) { %>
          <div class="notice notice--info">
            <span class="notice__icon"><%- ic('info') %></span>
            <div class="notice__body">
              <p>This page explains the treatment in general terms. Whether it is right for you depends on an examination:
              <%= clinic.doctor || 'the dentist' %> will look at your teeth and gums, explain what is found, and go through the options with you before anything is decided.</p>
            </div>
          </div>
          <% } %>
        </section>
        <% }) %>
      </article>

      <%# Sticky contact card: the dentist, where, today's status and the ways to act. %>
      <aside class="tx-aside" aria-labelledby="asideTitle">
        <div class="card tx-aside__card">
          <div class="card__body">
            <h2 class="visually-hidden-ds" id="asideTitle">Book or ask about <%= service.name %></h2>
            <div class="tx-aside__doctor">
              <% if (doctorPhoto) { %>
                <img src="<%= doctorPhoto.url %>" alt="" width="56" height="56" loading="lazy" decoding="async">
              <% } %>
              <div>
                <strong><%= clinic.doctor %></strong>
                <span class="text-small text-muted"><%= clinic.qualification %></span>
              </div>
            </div>
            <dl class="tx-aside__meta">
              <div><dt>Where</dt><dd><%= clinic.address %></dd></div>
              <div><dt>Today</dt><dd><span class="status-pill status-pill--<%= clinic.today.now.state %>"><span class="status-pill__dot" aria-hidden="true"></span><%= clinic.today.now.label %></span></dd></div>
            </dl>
            <div class="tx-aside__actions">
              <a href="<%= bookHref %>" class="button button--primary button--block" data-track="appointment_started"><%- ic('calendar') %>Book an appointment</a>
              <button type="button" class="button button--secondary button--block" data-callback-open data-service="<%= service.id %>" data-service-name="<%= service.name %>"><%- ic('callback') %>Request a call back</button>
              <% if (tel) { %><a href="<%= tel %>" class="button button--text button--block" data-track="call_clicked"><%- ic('phone') %>Call <%= clinic.phone %></a><% } %>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ QUESTIONS ============ -->
  <% if (faqs.length) { %>
  <section class="section section--surface" id="faq" aria-labelledby="faqTitle">
    <div class="container faq-split">
      <div class="faq-split__head" data-reveal-group>
        <p class="chapter" data-reveal><span class="chapter__index"><%= String(chapters.length + 1).padStart(2, '0') %></span><span class="chapter__rule" aria-hidden="true"></span><span class="chapter__name">Good to know</span></p>
        <h2 id="faqTitle" data-reveal>Questions patients ask</h2>
      </div>
      <div class="accordion" data-accordion>
        <% faqs.forEach(function (f, i) { %>
        <div class="accordion__item">
          <h3 class="accordion__heading">
            <button type="button" class="accordion__trigger" aria-expanded="false" aria-controls="faq-a-<%= i %>" id="faq-q-<%= i %>">
              <%= f.question %><span class="accordion__icon"><%- ic('plus') %></span>
            </button>
          </h3>
          <div class="accordion__panel" id="faq-a-<%= i %>" role="region" aria-labelledby="faq-q-<%= i %>" data-collapsed>
            <p><%= f.answer %></p>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ============ RELATED ============ -->
  <% if (related.length) { %>
  <section class="section" aria-labelledby="relatedTitle">
    <div class="container">
      <div class="index-head" data-reveal>
        <h2 id="relatedTitle">Related treatments</h2>
      </div>
      <div class="treatments-rows treatments-rows--flush">
        <% related.forEach(function (s, i) { %><%- include('partials/treatment-card', { s: s, variant: 'row', index: i }) %><% }) %>
      </div>
      <p class="section-foot"><a class="button button--secondary" href="/services">See all treatments</a></p>
    </div>
  </section>
  <% } else { %>
  <div class="container"><p class="section-foot"><a class="button button--secondary" href="/services">See all treatments</a></p></div>
  <% } %>

  <!-- ============ CLOSING SCENE ============ -->
  <section class="section section--night closing" aria-labelledby="closingTitle">
    <div class="container closing__grid closing__grid--solo">
      <div class="closing__copy" data-reveal-group>
        <p class="eyebrow-label" data-reveal>Ready when you are</p>
        <h2 id="closingTitle" class="closing__title" data-reveal>Talk to <%= clinic.doctor || 'the dentist' %> about <em class="display-em"><%= service.name.toLowerCase() %></em></h2>
        <p class="closing__body" data-reveal>Book online, or ask the clinic a question first &mdash; whichever you prefer.</p>
        <div class="cluster closing__actions" data-reveal>
          <a href="<%= bookHref %>" class="button button--inverse" data-track="appointment_started"><%- ic('calendar') %>Book an appointment</a>
          <% if (tel) { %><a href="<%= tel %>" class="button button--ghost-light" data-track="call_clicked"><%- ic('phone') %>Call <%= clinic.phone %></a><% } %>
        </div>
      </div>
    </div>
  </section>

</main>

<%- include('partials/site-footer') %>
<script src="/js/ds.js" defer></script>
<script src="/js/site-ds.js" defer></script>
<script src="/js/motion.js" defer></script>
</body>
</html>
