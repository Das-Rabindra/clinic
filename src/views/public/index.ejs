<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body class="has-action-bar has-cine-hero">
<% var ic = function (n, label) { return include('partials/icon', { name: n, label: label }); }; %>
<% var tel = clinic.phone ? 'tel:' + (clinic.phone_intl || clinic.phone) : null; %>
<% var chapter = function (num, name) { %><p class="chapter" data-reveal><span class="chapter__index"><%= num %></span><span class="chapter__rule" aria-hidden="true"></span><span class="chapter__name"><%= name %></span></p><% }; %>

<a class="skip-to-content" href="#main">Skip to content</a>

<%- include('partials/site-header') %>

<main id="main">

  <!-- ============ OPENING SCENE ============ -->
  <%# The clinic's own treatment room, full-bleed, with the headline set over
      it line by line. The overlay is strongest where the text sits, so white
      type holds 5:1 or better over the brightest part of the photograph. %>
  <section class="cine-hero" id="top" data-hero aria-labelledby="heroTitle">
    <div class="cine-hero__media" data-parallax>
      <div class="cine-hero__frame">
        <img src="<%= heroImage.url %>" alt="<%= heroImage.alt || '' %>"
             <% if (heroImage.srcset) { %>srcset="<%= heroImage.srcset %>" sizes="100vw"<% } %>
             width="<%= heroImage.width %>" height="<%= heroImage.height %>"
             fetchpriority="high" decoding="async">
      </div>
    </div>
    <div class="cine-hero__shade" aria-hidden="true"></div>
    <%# Film grain and a scroll-driven dimmer: decoration only, both inert. %>
    <div class="cine-hero__grain" aria-hidden="true"></div>
    <div class="cine-hero__dim" aria-hidden="true" data-hero-dim></div>

    <div class="container cine-hero__content" data-hero-content>
      <% if (settings.hero_eyebrow) { %><p class="cine-hero__eyebrow"><span class="cine-hero__pin"><%- ic('pin') %></span><%= settings.hero_eyebrow %></p><% } %>
      <h1 class="hero__title cine-hero__title" id="heroTitle">
        <% heroLines.forEach(function (line, i) { %><span class="cine-line"><span class="cine-line__inner" style="--line:<%= i %>"><% if (i === heroLines.length - 1 && heroLines.length > 1) { %><em class="display-em"><%= line %></em><% } else { %><%= line %><% } %></span></span><% if (i < heroLines.length - 1) { %> <% } %><% }) %>
      </h1>
      <% if (settings.hero_lede) { %><p class="hero__lede cine-hero__lede"><%= settings.hero_lede %></p><% } %>
      <div class="cine-hero__actions">
        <a href="#appointment" class="button button--inverse" data-track="appointment_started"><%- ic('calendar') %><%= settings.hero_cta_label || 'Book an appointment' %></a>
        <a href="#services" class="button button--ghost-light">Explore treatments <%- ic('arrow') %></a>
      </div>
      <% if (settings.hero_trust_text) { %><p class="hero__note cine-hero__note"><%- ic('check') %><%= settings.hero_trust_text %></p><% } %>
    </div>

    <%# Says what the photograph is, as a film still would. Only for the
        clinic's own photograph, never for anything else the admin sets. %>
    <% if (heroImage.caption) { %>
    <p class="cine-hero__caption" aria-hidden="true"><span class="cine-hero__caption-mark"></span><%= heroImage.caption %></p>
    <% } %>

    <%# One compact trust row: who, registration, where, and today's status. %>
    <div class="cine-hero__rail">
      <div class="container cine-hero__rail-inner">
        <% if (clinic.doctor) { %>
        <ul class="trust-row" aria-label="About the dentist">
          <li><%- ic('cap') %><span><strong><%= clinic.doctor %></strong><% if (clinic.qualification) { %>, <%= clinic.qualification %><% } %></span></li>
          <% if (clinic.registration) { %><li><%- ic('shield') %><span><%= clinic.registration %></span></li><% } %>
          <% if (shortAddress) { %><li><%- ic('pin') %><span><%= shortAddress %></span></li><% } %>
        </ul>
        <% } %>
        <p class="status-pill status-pill--<%= clinic.today.now.state %> cine-hero__status"><span class="status-pill__dot" aria-hidden="true"></span><%= clinic.today.now.label %></p>
      </div>
    </div>
  </section>

  <!-- ============ URGENT CARE ============ -->
  <%# Hours here come from the live weekly grid, break included. %>
  <% if (emergency) { %>
  <aside class="urgent" aria-labelledby="urgentTitle">
    <div class="container urgent__row">
      <div class="urgent__text">
        <%- ic('alert') %>
        <p><strong id="urgentTitle">In pain today?</strong>
          <% if (todayHoursDisplay) { %>
            The clinic is open today <%= todayHoursDisplay.text.replace(' – ', ' to ') %><% if (todayHoursDisplay.breakText) { %>, closed <%= todayHoursDisplay.breakText.replace('Closed ', '').replace(' – ', ' to ') %><% } %>, and keeps time free for urgent problems.
          <% } else { %>
            Call the clinic to ask about urgent care.
          <% } %>
        </p>
      </div>
      <div class="urgent__actions">
        <% if (tel) { %><a class="button button--primary button--small" href="<%= tel %>" data-track="emergency_call"><%- ic('phone') %>Call <%= clinic.phone %></a><% } %>
        <a class="button button--text button--small" href="/services/<%= emergency.slug %>">What counts as an emergency</a>
      </div>
    </div>
  </aside>
  <% } %>

  <!-- ============ 01 · THE DENTIST ============ -->
  <section class="section chapter-section" id="about" aria-labelledby="aboutTitle">
    <div class="container profile">
      <figure class="profile__photo">
        <div class="profile__frame" data-reveal="image">
          <% if (doctorPhoto) { %>
            <img src="<%= doctorPhoto.url %>"<% var ss = mediaSrcset(doctorPhoto.url, doctorPhoto.width, doctorPhoto.medium_url, doctorPhoto.medium_width); if (ss) { %> srcset="<%= ss %>" sizes="(min-width: 1024px) 480px, (min-width: 480px) 26rem, calc(100vw - 32px)"<% } %> alt="<%= clinic.doctor %>" width="<%= doctorPhoto.width %>" height="<%= doctorPhoto.height %>" loading="lazy" decoding="async">
          <% } else { %>
            <div class="profile__placeholder"><%- ic('camera') %><span>Photograph of <%= clinic.doctor || 'the dentist' %> coming soon</span></div>
          <% } %>
        </div>
        <% if (clinic.doctor) { %><figcaption class="profile__caption"><%= clinic.doctor %><% if (clinic.qualification) { %> · <%= clinic.qualification %><% } %></figcaption><% } %>
      </figure>
      <div class="profile__body" data-reveal-group>
        <% chapter('01', 'The dentist'); %>
        <h2 id="aboutTitle" class="profile__title" data-reveal><%= settings.about_title || clinic.doctor %></h2>
        <% if (settings.about_body) { %><blockquote class="profile__quote" data-reveal><p><%= settings.about_body %></p></blockquote><% } %>
        <% if (showDoctorBio) { %><p class="prose" data-reveal><%= doctor.bio %></p><% } %>
        <dl class="facts-list" data-reveal>
          <% if (clinic.qualification) { %><div><dt>Qualification</dt><dd><%= clinic.qualification %></dd></div><% } %>
          <% if (clinic.institution) { %><div><dt>Institution</dt><dd><%= clinic.institution %></dd></div><% } %>
          <% if (clinic.registration) { %><div><dt>Registration</dt><dd><%= clinic.registration %></dd></div><% } %>
          <% if (doctor && doctor.specialization) { %><div><dt>Focus</dt><dd><%= doctor.specialization %></dd></div><% } %>
          <% if (doctor && doctor.languages) { %><div><dt>Languages</dt><dd><%= doctor.languages %></dd></div><% } %>
        </dl>
        <p class="profile__more" data-reveal><a class="link link--arrow" href="/about">More about the dentist and the clinic <%- ic('arrow') %></a></p>
      </div>
    </div>
  </section>

  <!-- ============ 02 · THE CLINIC ============ -->
  <%# The clinic's own story, then facts it has entered itself (hours from the
      weekly grid, languages from the doctor record). Nothing here is a claim
      written for the page. The still life is illustrative and says so. %>
  <section class="section section--sage chapter-section" aria-labelledby="clinicTitle">
    <div class="container clinic">
      <div class="clinic__lead" data-reveal-group>
        <% chapter('02', 'The clinic'); %>
        <h2 id="clinicTitle" class="clinic__title" data-reveal><%= settings.story_title || 'The clinic' %></h2>
        <% if (settings.story_body) { %><p class="clinic__story" data-reveal><%= settings.story_body %></p><% } %>
      </div>
      <figure class="clinic__still">
        <div class="clinic__still-frame" data-reveal="image">
          <img src="/img/stock/dental-implant-1024.webp" srcset="/img/stock/dental-implant-640.webp 640w, /img/stock/dental-implant-1024.webp 1024w, /img/stock/dental-implant-1600.webp 1600w"
               sizes="(min-width: 1024px) 40vw, 100vw" alt="" width="1024" height="696" loading="lazy" decoding="async">
        </div>
        <figcaption class="illustrative-note">Illustration</figcaption>
      </figure>
      <ol class="clinic__facts" data-reveal-group>
        <li data-reveal><span class="clinic__num" aria-hidden="true">i.</span><div><h3>Opening hours</h3><p>Open <%= hoursSummary %>.</p><a class="link link--arrow" href="#location">Weekly hours <%- ic('arrow') %></a></div></li>
        <li data-reveal><span class="clinic__num" aria-hidden="true">ii.</span><div><h3>Book online</h3><p>Choose a treatment, a day and a time from the clinic's live availability.</p><a class="link link--arrow" href="#appointment">Book an appointment <%- ic('arrow') %></a></div></li>
        <% if (doctor && doctor.languages) { %>
        <li data-reveal><span class="clinic__num" aria-hidden="true">iii.</span><div><h3>Languages</h3><p><%= doctor.languages %></p></div></li>
        <% } %>
      </ol>
    </div>
  </section>

  <!-- ============ 03 · TREATMENTS ============ -->
  <section class="section chapter-section" id="services" aria-labelledby="servicesTitle">
    <div class="container">
      <div class="split-heading" data-reveal-group>
        <div>
          <% chapter('03', settings.treatments_eyebrow || 'Treatments'); %>
          <h2 id="servicesTitle" data-reveal><%= settings.services_title || 'Dental treatments offered at the clinic' %></h2>
        </div>
        <% if (settings.services_lede) { %><p class="split-heading__lede" data-reveal><%= settings.services_lede %></p><% } %>
      </div>

      <% if (services.length) { %>
        <%# Two lead treatments as large image tiles, the next four as editorial
            rows — variety without losing a single consistent card language. %>
        <div class="treatments-lead">
          <% featuredServices.slice(0, 2).forEach(function (s) { %>
            <%- include('partials/treatment-card', { s: s, variant: 'tile' }) %>
          <% }) %>
        </div>
        <% if (featuredServices.length > 2) { %>
        <div class="treatments-rows">
          <% featuredServices.slice(2).forEach(function (s, i) { %>
            <%- include('partials/treatment-card', { s: s, variant: 'row', index: i + 2 }) %>
          <% }) %>
        </div>
        <% } %>
        <p class="illustrative-note cards-note">Photographs are illustrative</p>

        <% if (otherServices.length) { %>
        <div class="more-treatments" data-reveal>
          <h3 class="more-treatments__title">Also treated at the clinic</h3>
          <ul>
            <% otherServices.forEach(function (s) { %>
            <li><a href="/services/<%= s.slug %>"><span><%= s.name %></span><%- ic('arrow') %></a></li>
            <% }) %>
          </ul>
        </div>
        <% } %>
        <p class="section-foot"><a class="button button--secondary" href="/services">See all treatments <%- ic('arrow') %></a></p>
      <% } else { %>
        <div class="empty-state">
          <h3>Treatments are being updated</h3>
          <p>Please call <% if (tel) { %><a class="link" href="<%= tel %>"><%= clinic.phone %></a><% } %> and the clinic will tell you what is available.</p>
        </div>
      <% } %>
    </div>
  </section>

  <!-- ============ 04 · INSIDE THE CLINIC (night) ============ -->
  <%# A screening room: the clinic's own photographs as lit stills on night,
      shown whole (a poster or a before & after loses its meaning when
      cropped), each opening full size in the viewer. One photograph alone is
      shown large; two to four as a lead and a stack; five or more scroll. %>
  <%# reveal: off in the carousel, whose off-screen stills would wait for a
      sideways scroll to appear. %>
  <% var still = function (g, i, sizes, lead, reveal) { %>
    <figure class="screens__item<%= lead ? ' screens__item--lead' : '' %>">
      <a class="screen" href="<%= g.image_url %>" data-lightbox data-caption="<%= g.title %><%= g.description ? ' — ' + g.description : '' %>"<% if (reveal !== false) { %> data-reveal="image"<% } %>>
        <% var ss = mediaSrcset(g.image_url, g.width, g.medium_url, g.medium_width); %>
        <img src="<%= g.medium_url || g.image_url %>"<% if (ss) { %> srcset="<%= ss %>" sizes="<%= sizes %>"<% } %> alt="<%= g.image_alt || g.title %>"
             width="<%= g.width || 1200 %>" height="<%= g.height || 1200 %>" loading="lazy" decoding="async">
        <span class="screen__zoom" aria-hidden="true"><%- ic('plus') %></span>
      </a>
      <figcaption><span class="screens__n" aria-hidden="true"><%= String(i + 1).padStart(2, '0') %></span><span><%= g.title %></span></figcaption>
    </figure>
  <% }; %>
  <section class="section section--night chapter-section gallery-night" id="gallery" aria-labelledby="galleryTitle">
    <div class="container">
      <div class="split-heading" data-reveal-group>
        <div>
          <% chapter('04', 'Inside the clinic'); %>
          <h2 id="galleryTitle" data-reveal><%= settings.gallery_title || 'A closer look at the clinic' %></h2>
        </div>
        <% if (settings.gallery_lede) { %><p class="split-heading__lede" data-reveal><%= settings.gallery_lede %></p><% } %>
      </div>

      <% if (galleryMode === 'empty') { %>
        <div class="empty-state"><%- ic('camera') %><h3>Photographs coming soon</h3><p>Photographs of the clinic will appear here.</p></div>
      <% } else if (galleryMode === 'single') { %>
        <div class="screens screens--1"><% still(gallery[0], 0, '(min-width: 768px) 46rem, 100vw', true); %></div>
      <% } else if (galleryMode === 'grid') { %>
        <div class="screens screens--<%= gallery.length %>">
          <% gallery.forEach(function (g, i) { still(g, i, i === 0 ? '(min-width: 768px) 55vw, 100vw' : '(min-width: 768px) 40vw, 100vw', i === 0); }) %>
        </div>
      <% } else { %>
        <div class="carousel carousel--night" data-carousel>
          <ul class="carousel__track" data-carousel-track tabindex="0" aria-label="Clinic photographs, scrollable">
            <% gallery.forEach(function (g, i) { %><li class="carousel__item"><% still(g, i, '(min-width: 768px) 40vw, 85vw', false, false); %></li><% }) %>
          </ul>
          <div class="carousel__controls" data-carousel-controls>
            <button type="button" class="button button--ghost-light button--small" data-carousel-prev aria-label="Previous photographs"><%- ic('chevronLeft') %></button>
            <span class="text-small" data-carousel-status aria-live="polite"></span>
            <button type="button" class="button button--ghost-light button--small" data-carousel-next aria-label="More photographs"><%- ic('chevronRight') %></button>
          </div>
        </div>
      <% } %>
      <p class="section-foot"><a class="button button--ghost-light" href="/gallery">See the full gallery <%- ic('arrow') %></a></p>
    </div>
  </section>

  <!-- ============ 05 · WORDS FROM PATIENTS ============ -->
  <%- include('partials/reviews', { chapterNum: '05' }) %>

  <!-- ============ 06 · QUESTIONS ============ -->
  <% if (faqs.length) { %>
  <section class="section section--surface chapter-section" id="faq" aria-labelledby="faqTitle">
    <div class="container faq-split">
      <div class="faq-split__head" data-reveal-group>
        <% chapter('06', 'Good to know'); %>
        <h2 id="faqTitle" data-reveal>Frequently asked questions</h2>
        <p class="text-muted" data-reveal>Something not covered here?
          <% if (tel) { %><a class="link" href="<%= tel %>" data-track="call_clicked">Call <%= clinic.phone %></a><% } %>
          <% if (whatsappUrl) { %> or <a class="link" href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-track="whatsapp_clicked">message on WhatsApp</a><% } %>.</p>
        <p data-reveal><a class="link link--arrow" href="/faq">All questions, including each treatment <%- ic('arrow') %></a></p>
      </div>
      <div class="accordion" data-accordion>
        <% faqs.forEach(function (f, i) { %>
        <div class="accordion__item">
          <h3 class="accordion__heading">
            <button type="button" class="accordion__trigger" aria-expanded="false" aria-controls="faq-a-<%= i %>" id="faq-q-<%= i %>">
              <%= f.question %><span class="accordion__icon"><%- ic('plus') %></span>
            </button>
          </h3>
          <div class="accordion__panel" id="faq-a-<%= i %>" role="region" aria-labelledby="faq-q-<%= i %>" data-collapsed>
            <p><%= f.answer %></p>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ============ 07 · BOOK (night) ============ -->
  <%# data-bar-yield: the mobile action bar steps aside while this is on
      screen, so it can never cover the wizard's Continue button. %>
  <section class="section section--night chapter-section booking-night" id="appointment" data-bar-yield aria-labelledby="bookTitle">
    <div class="container booking-layout">
      <div class="booking-layout__intro" data-reveal-group>
        <% chapter('07', 'Book a visit'); %>
        <h2 id="bookTitle" class="booking-night__title" data-reveal>Book an <em class="display-em">appointment</em></h2>
        <p class="section-heading__lede" data-reveal>Choose a treatment, pick a date and reserve a time that suits you. The times shown come straight from the clinic's diary.</p>
        <figure class="booking-night__still" data-reveal>
          <img src="/img/stock/dentist-uv-curing-640.webp" srcset="/img/stock/dentist-uv-curing-640.webp 640w, /img/stock/dentist-uv-curing-1024.webp 1024w"
               sizes="(min-width: 1024px) 30vw, 100vw" alt="" width="640" height="427" loading="lazy" decoding="async">
          <figcaption class="illustrative-note">Illustrative photograph</figcaption>
        </figure>
        <div class="booking-layout__fallback" data-reveal>
          <p class="form-label">Prefer to talk to someone?</p>
          <div class="cluster">
            <% if (tel) { %><a class="button button--inverse button--small" href="<%= tel %>" data-track="call_clicked"><%- ic('phone') %>Call <%= clinic.phone %></a><% } %>
            <% if (whatsappUrl) { %><a class="button button--ghost-light button--small" href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-track="whatsapp_clicked"><%- ic('whatsapp') %>WhatsApp</a><% } %>
            <button type="button" class="button button--text button--small" data-callback-open><%- ic('callback') %>Request a call back</button>
          </div>
        </div>
      </div>

      <%- include('partials/booking-panel') %>
    </div>
  </section>

  <!-- ============ 08 · VISIT ============ -->
  <section class="section chapter-section visit" id="location" aria-labelledby="visitTitle">
    <div class="container visit__grid">
      <div class="visit__map" data-reveal="image">
        <iframe class="contact-bento__frame" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          data-src="<%= clinic.map_embed_url %>"
          title="Map showing <%= clinic.name %>, <%= shortAddress %>"></iframe>
      </div>
      <div class="visit__info" data-reveal-group>
        <% chapter('08', 'Find us'); %>
        <h2 id="visitTitle" data-reveal><%= settings.location_title || 'Visit the clinic' %></h2>
        <% if (settings.location_body) { %><p class="text-muted" data-reveal><%= settings.location_body %></p><% } %>

        <div class="visit__block" data-reveal>
          <h3 class="visit__label"><%- ic('pin') %>Address</h3>
          <address class="contact-bento__lines"><%- addressHtml %></address>
          <div class="cluster">
            <a class="button button--primary button--small" href="<%= clinic.directions_url %>" target="_blank" rel="noopener" data-track="directions_clicked"><%- ic('directions') %>Get directions</a>
          </div>
        </div>

        <div class="visit__block" data-reveal>
          <h3 class="visit__label"><%- ic('phone') %>Call or message</h3>
          <ul class="contact-list">
            <% if (tel) { %><li><a href="<%= tel %>" data-track="call_clicked"><%= clinic.phone %></a><span class="text-small text-muted">Main line<% if (whatsappUrl) { %> and WhatsApp<% } %></span></li><% } %>
            <% if (clinic.phone_secondary) { %><li><a href="tel:<%= clinic.phone_secondary_intl || clinic.phone_secondary %>" data-track="call_clicked"><%= clinic.phone_secondary %></a><span class="text-small text-muted">Second line</span></li><% } %>
          </ul>
          <div class="cluster">
            <% if (whatsappUrl) { %><a class="button button--secondary button--small" href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-track="whatsapp_clicked"><%- ic('whatsapp') %>WhatsApp</a><% } %>
            <button type="button" class="button button--text button--small" data-callback-open>Request a call back</button>
          </div>
        </div>

        <div class="visit__block contact-bento__hours" data-reveal>
          <h3 class="visit__label"><%- ic('clock') %>Opening hours</h3>
          <p class="status-pill status-pill--<%= clinic.today.now.state %>"><span class="status-pill__dot" aria-hidden="true"></span><%= clinic.today.now.label %></p>
          <table class="hours-table-ds">
            <caption class="visually-hidden-ds">Weekly opening hours</caption>
            <tbody>
            <% weekHours.forEach(function (h) { var d = h.display; var isToday = h.weekday === clinic.today.weekdayIndex; %>
              <tr<% if (isToday) { %> class="is-today" aria-current="date"<% } %>>
                <th scope="row"><%= h.day %><% if (isToday) { %> <span class="badge">Today</span><% } %></th>
                <td>
                  <% if (d.closed) { %>Closed<% } else { %>
                    <% d.sessions.forEach(function (sess, i) { %><span class="hours-table-ds__session"><% if (i) { %><span class="visually-hidden-ds">and </span><% } %><%= sess %></span><% }) %>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
        <%- include('partials/social') %>
        <p class="visit__more" data-reveal><a class="link link--arrow" href="/contact">All the ways to reach the clinic <%- ic('arrow') %></a></p>
      </div>
    </div>
  </section>

  <!-- ============ CLOSING SCENE (night) ============ -->
  <section class="section section--night closing" id="contact" aria-labelledby="closingTitle">
    <div class="container closing__grid">
      <div class="closing__copy" data-reveal-group>
        <p class="eyebrow-label" data-reveal>Ready when you are</p>
        <h2 id="closingTitle" class="closing__title" data-reveal><%= settings.cta_title || 'Book a visit' %></h2>
        <% if (settings.cta_body) { %><p class="closing__body" data-reveal><%= settings.cta_body %></p><% } %>
        <div class="cluster closing__actions" data-reveal>
          <a href="#appointment" class="button button--inverse" data-track="appointment_started"><%- ic('calendar') %>Book an appointment</a>
          <% if (tel) { %><a href="<%= tel %>" class="button button--ghost-light" data-track="call_clicked"><%- ic('phone') %>Call <%= clinic.phone %></a><% } %>
        </div>
      </div>
      <figure class="closing__still">
        <div class="closing__frame" data-reveal="image">
          <img src="/img/stock/smile-exam-1024.webp" srcset="/img/stock/smile-exam-640.webp 640w, /img/stock/smile-exam-1024.webp 1024w, /img/stock/smile-exam-1600.webp 1600w"
               sizes="(min-width: 1024px) 40vw, 100vw" alt="" width="1024" height="910" loading="lazy" decoding="async">
        </div>
        <figcaption class="illustrative-note">Illustrative photograph</figcaption>
      </figure>
    </div>
  </section>

</main>

<%- include('partials/lightbox') %>
<%- include('partials/site-footer') %>

<script src="/js/ds.js" defer></script>
<script src="/js/site-ds.js" defer></script>
