<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body class="has-action-bar">
<% var ic = function (n, label) { return include('partials/icon', { name: n, label: label }); }; %>
<% var tel = clinic.phone ? 'tel:' + (clinic.phone_intl || clinic.phone) : null; %>

<a class="skip-to-content" href="#main">Skip to content</a>

<%- include('partials/site-header') %>

<main id="main">

  <!-- ============ HERO ============ -->
  <section class="hero" id="top">
    <div class="container hero__grid">
      <div class="hero__copy">
        <% if (settings.hero_eyebrow) { %><span class="eyebrow-label"><%= settings.hero_eyebrow %></span><% } %>
        <h1 class="hero__title"><%- heroTitleHtml %></h1>
        <% if (settings.hero_lede) { %><p class="hero__lede"><%= settings.hero_lede %></p><% } %>

        <div class="hero__actions">
          <a href="#appointment" class="button button--primary" data-track="appointment_started"><%- ic('calendar') %><%= settings.hero_cta_label || 'Book an appointment' %></a>
          <div class="hero__secondary">
            <% if (tel) { %><a href="<%= tel %>" class="button button--secondary" data-track="call_clicked"><%- ic('phone') %>Call</a><% } %>
            <% if (whatsappUrl) { %><a href="<%= whatsappUrl %>" target="_blank" rel="noopener" class="button button--secondary" data-track="whatsapp_clicked"><%- ic('whatsapp') %>WhatsApp</a><% } %>
          </div>
        </div>

        <%# One compact trust row. The credentials used to appear three times in
            the first screen (lede, trust card, credential strip). %>
        <% if (clinic.doctor) { %>
        <% if (settings.hero_trust_text) { %><p class="hero__note"><%- ic('check') %><%= settings.hero_trust_text %></p><% } %>
        <ul class="trust-row" aria-label="About the dentist">
          <li><%- ic('cap') %><span><strong><%= clinic.doctor %></strong><% if (clinic.qualification) { %>, <%= clinic.qualification %><% } %></span></li>
          <% if (clinic.registration) { %><li><%- ic('shield') %><span><%= clinic.registration %></span></li><% } %>
          <% if (shortAddress) { %><li><%- ic('pin') %><span><%= shortAddress %></span></li><% } %>
        </ul>
        <% } %>
      </div>

      <% if (heroImage) { %>
      <figure class="hero__media">
        <img src="<%= heroImage.url %>" alt="<%= heroImage.alt || '' %>"
             <% if (heroImage.srcset) { %>srcset="<%= heroImage.srcset %>" sizes="<%= heroImage.sizes %>"<% } %>
             width="<%= heroImage.width %>" height="<%= heroImage.height %>"
             fetchpriority="high" decoding="async">
      </figure>
      <% } %>
    </div>
  </section>

  <!-- ============ URGENT CARE ============ -->
  <%# Hours here come from the live weekly grid, break included — this band
      used to say "open until 10 PM every day" while the clinic closes 1–3 PM. %>
  <% if (emergency) { %>
  <aside class="urgent" aria-labelledby="urgentTitle">
    <div class="container urgent__row">
      <div class="urgent__text">
        <%- ic('alert') %>
        <p><strong id="urgentTitle">In pain today?</strong>
          <% if (todayHoursDisplay) { %>
            The clinic is open today <%= todayHoursDisplay.text.replace(' – ', ' to ') %><% if (todayHoursDisplay.breakText) { %>, closed <%= todayHoursDisplay.breakText.replace('Closed ', '').replace(' – ', ' to ') %><% } %>, and keeps time free for urgent problems.
          <% } else { %>
            Call the clinic to ask about urgent care.
          <% } %>
        </p>
      </div>
      <div class="urgent__actions">
        <% if (tel) { %><a class="button button--primary button--small" href="<%= tel %>" data-track="emergency_call"><%- ic('phone') %>Call <%= clinic.phone %></a><% } %>
        <a class="button button--text button--small" href="/services/<%= emergency.slug %>">What counts as an emergency</a>
      </div>
    </div>
  </aside>
  <% } %>

  <!-- ============ DENTIST ============ -->
  <section class="section" id="about">
    <div class="container profile">
      <div class="profile__photo">
        <% if (doctorPhoto) { %>
          <img src="<%= doctorPhoto.url %>" alt="<%= clinic.doctor %>" width="<%= doctorPhoto.width %>" height="<%= doctorPhoto.height %>" loading="lazy" decoding="async">
        <% } else { %>
          <div class="profile__placeholder"><%- ic('camera') %><span>Photograph of <%= clinic.doctor || 'the dentist' %> coming soon</span></div>
        <% } %>
      </div>
      <div class="profile__body">
        <div class="section-heading">
          <span class="eyebrow-label">The dentist</span>
          <h2><%= settings.about_title || clinic.doctor %></h2>
        </div>
        <div class="prose">
          <% if (settings.about_body) { %><p class="text-body-lg"><%= settings.about_body %></p><% } %>
          <% if (showDoctorBio) { %><p><%= doctor.bio %></p><% } %>
        </div>
        <dl class="facts-list">
          <% if (clinic.qualification) { %><div><dt>Qualification</dt><dd><%= clinic.qualification %></dd></div><% } %>
          <% if (clinic.institution) { %><div><dt>Institution</dt><dd><%= clinic.institution %></dd></div><% } %>
          <% if (clinic.registration) { %><div><dt>Registration</dt><dd><%= clinic.registration %></dd></div><% } %>
          <% if (doctor && doctor.specialization) { %><div><dt>Focus</dt><dd><%= doctor.specialization %></dd></div><% } %>
          <% if (doctor && doctor.languages) { %><div><dt>Languages</dt><dd><%= doctor.languages %></dd></div><% } %>
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ THE CLINIC ============ -->
  <%# Bento of facts the clinic has entered itself — hours from the weekly grid,
      languages from the doctor record, the address — beside its own story.
      Nothing here is a claim written for the page. %>
  <section class="section section--sage" aria-labelledby="clinicTitle">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow-label">The clinic</span>
        <h2 id="clinicTitle"><%= settings.story_title || 'The clinic' %></h2>
      </div>
      <div class="bento bento--3 clinic-bento">
        <% if (settings.story_body) { %>
        <div class="card bento__wide clinic-bento__story"><div class="card__body"><p class="text-body-lg"><%= settings.story_body %></p></div></div>
        <% } %>
        <div class="card"><div class="card__body">
          <span class="clinic-bento__icon"><%- ic('clock') %></span>
          <h3 class="card__title">Opening hours</h3>
          <p class="card__text">Open <%= hoursSummary %>.</p>
          <a class="link link--arrow" href="#location">Weekly hours <%- ic('arrow') %></a>
        </div></div>
        <div class="card"><div class="card__body">
          <span class="clinic-bento__icon"><%- ic('calendar') %></span>
          <h3 class="card__title">Book online</h3>
          <p class="card__text">Choose a treatment, a day and a time from the clinic's live availability.</p>
          <a class="link link--arrow" href="#appointment">Book an appointment <%- ic('arrow') %></a>
        </div></div>
        <% if (doctor && doctor.languages) { %>
        <div class="card"><div class="card__body">
          <span class="clinic-bento__icon"><%- ic('language') %></span>
          <h3 class="card__title">Languages</h3>
          <p class="card__text"><%= doctor.languages %></p>
        </div></div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- ============ TREATMENTS ============ -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow-label"><%= settings.treatments_eyebrow || 'Treatments' %></span>
        <h2><%= settings.services_title || 'Dental treatments offered at the clinic' %></h2>
        <% if (settings.services_lede) { %><p class="section-heading__lede"><%= settings.services_lede %></p><% } %>
      </div>

      <% if (services.length) { %>
        <div class="treatment-grid">
          <% featuredServices.forEach(function (s) { %>
            <%- include('partials/treatment-card', { s: s }) %>
          <% }) %>
        </div>

        <% if (otherServices.length) { %>
        <div class="more-treatments">
          <h3 class="more-treatments__title">Also treated at the clinic</h3>
          <ul>
            <% otherServices.forEach(function (s) { %>
            <li><a href="/services/<%= s.slug %>"><span><%= s.name %></span><%- ic('arrow') %></a></li>
            <% }) %>
          </ul>
        </div>
        <% } %>
        <p class="section-foot"><a class="button button--secondary" href="/services">See all treatments</a></p>
      <% } else { %>
        <div class="empty-state">
          <h3>Treatments are being updated</h3>
          <p>Please call <% if (tel) { %><a class="link" href="<%= tel %>"><%= clinic.phone %></a><% } %> and the clinic will tell you what is available.</p>
        </div>
      <% } %>
    </div>
  </section>

  <!-- ============ GALLERY ============ -->
  <%# Layout follows the number of real photographs: one is shown on its own,
      two to four as a grid, five or more as a carousel. No controls for a
      single image, and no images that are not the clinic's own uploads. %>
  <section class="section section--surface" id="gallery">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow-label">Inside the clinic</span>
        <h2><%= settings.gallery_title || 'A closer look at the clinic' %></h2>
        <% if (settings.gallery_lede) { %><p class="section-heading__lede"><%= settings.gallery_lede %></p><% } %>
      </div>

      <% if (galleryMode === 'empty') { %>
        <div class="empty-state"><%- ic('camera') %><h3>Photographs coming soon</h3><p>Photographs of the clinic will appear here.</p></div>
      <% } else if (galleryMode === 'single') { var g = gallery[0]; %>
        <figure class="gallery-feature">
          <img src="<%= g.image_url %>" alt="<%= g.image_alt || g.title %>" width="<%= g.width || 1200 %>" height="<%= g.height || 1200 %>" loading="lazy" decoding="async">
          <figcaption><%= g.title %><% if (g.description) { %> — <%= g.description %><% } %></figcaption>
        </figure>
      <% } else if (galleryMode === 'grid') { %>
        <div class="gallery-grid-ds">
          <% gallery.forEach(function (g) { %>
          <figure>
            <img src="<%= g.thumb_url || g.image_url %>" alt="<%= g.image_alt || g.title %>" width="480" height="480" loading="lazy" decoding="async">
            <figcaption><%= g.title %></figcaption>
          </figure>
          <% }) %>
        </div>
      <% } else { %>
        <div class="carousel" data-carousel>
          <ul class="carousel__track" data-carousel-track tabindex="0" aria-label="Clinic photographs, scrollable">
            <% gallery.forEach(function (g) { %>
            <li class="carousel__item">
              <figure>
                <img src="<%= g.image_url %>" alt="<%= g.image_alt || g.title %>" width="<%= g.width || 1200 %>" height="<%= g.height || 900 %>" loading="lazy" decoding="async">
                <figcaption><%= g.title %></figcaption>
              </figure>
            </li>
            <% }) %>
          </ul>
          <div class="carousel__controls" data-carousel-controls>
            <button type="button" class="button button--secondary button--small" data-carousel-prev aria-label="Previous photographs"><%- ic('chevronLeft') %></button>
            <span class="text-small text-muted" data-carousel-status aria-live="polite"></span>
            <button type="button" class="button button--secondary button--small" data-carousel-next aria-label="More photographs"><%- ic('chevronRight') %></button>
          </div>
        </div>
      <% } %>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="section" id="reviews">
    <div class="container">
      <div class="section-heading section-heading--center">
        <span class="eyebrow-label">Testimonials from patients</span>
        <h2><%= settings.reviews_title || 'What patients are saying' %></h2>
      </div>

      <% if (reviews.reviews.length) { %>
        <div class="rating-summary">
          <span class="rating-summary__score"><%= reviews.average %></span>
          <div>
            <span class="stars" role="img" aria-label="<%= reviews.average %> out of 5"><%- starsHtml(reviews.average) %></span>
            <p class="text-small text-muted">
              <% if (reviews.google_count && reviews.has_manual) { %>
                <%= reviews.google_count %> Google review<%= reviews.google_count === 1 ? '' : 's' %> and <%= reviews.count - reviews.google_count %> shared with the clinic
              <% } else { %>
                <%= reviews.google_count ? 'Google rating' : 'Patient feedback' %>, based on <%= reviews.count %> review<%= reviews.count === 1 ? '' : 's' %>
              <% } %>
            </p>
          </div>
        </div>
        <div class="carousel" data-carousel>
          <ul class="carousel__track carousel__track--reviews" data-carousel-track tabindex="0" aria-label="Patient testimonials, scrollable">
            <% reviews.reviews.forEach(function (r) { %>
            <li class="carousel__item">
              <article class="card review-card"><div class="card__body">
                <span class="stars" role="img" aria-label="<%= r.rating %> out of 5"><%- starsHtml(r.rating) %></span>
                <% if (r.text) { %><p><%= r.text %></p><% } %>
                <footer class="review-card__author">
                  <strong><%= r.author_name %></strong>
                  <span class="text-small text-muted"><% if (r.source === 'manual') { %>Shared with the clinic<% } else { %>Google review<% } %><% if (r.reviewed_at) { %> · <%= formatReviewDate(r.reviewed_at) %><% } %></span>
                </footer>
              </div></article>
            </li>
            <% }) %>
          </ul>
          <div class="carousel__controls" data-carousel-controls>
            <button type="button" class="button button--secondary button--small" data-carousel-prev aria-label="Previous testimonials"><%- ic('chevronLeft') %></button>
            <span class="text-small text-muted" data-carousel-status aria-live="polite"></span>
            <button type="button" class="button button--secondary button--small" data-carousel-next aria-label="More testimonials"><%- ic('chevronRight') %></button>
          </div>
        </div>
        <% if (clinic.reviews_url) { %>
        <p class="section-foot"><a class="button button--secondary" href="<%= clinic.reviews_url %>" target="_blank" rel="noopener">Read the reviews on Google</a></p>
        <% } %>
      <% } else { %>
        <div class="empty-state">
          <%- ic('star') %>
          <h3>Testimonials coming soon</h3>
          <p>This section shows genuine feedback only &mdash; reviews synced from the clinic&rsquo;s
          Google Business Profile, and testimonials patients have shared directly and agreed to
          have published. Nothing here is written by the clinic.</p>
          <% if (clinic.reviews_url && !reviewQr) { %>
            <p><a class="button button--secondary button--small" href="<%= clinic.reviews_url %>" target="_blank" rel="noopener">Leave a review on Google</a></p>
          <% } %>
        </div>
      <% } %>

      <% if (reviewQr) { %>
      <aside class="card review-qr" aria-labelledby="qrTitle">
        <div class="review-qr__code">
          <% if (clinic.reviews_url) { %><a href="<%= clinic.reviews_url %>" target="_blank" rel="noopener" aria-label="Open the Google review page for <%= clinic.name %>"><% } %>
            <img src="<%= reviewQr.url %>" alt="QR code linking to the Google review page for <%= clinic.name %>, <%= shortAddress %>"
                 width="<%= reviewQr.width || 320 %>" height="<%= reviewQr.height || 320 %>" loading="lazy" decoding="async">
          <% if (clinic.reviews_url) { %></a><% } %>
        </div>
        <div class="review-qr__text">
          <span class="eyebrow-label">Google</span>
          <h3 id="qrTitle"><%= settings.review_qr_title || 'Leave a review on Google' %></h3>
          <% if (settings.review_qr_body) { %><p class="text-muted"><%= settings.review_qr_body %></p><% } %>
          <% if (clinic.reviews_url) { %><a class="button button--secondary button--small" href="<%= clinic.reviews_url %>" target="_blank" rel="noopener">Open the review page</a><% } %>
        </div>
      </aside>
      <% } %>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <% if (faqs.length) { %>
  <section class="section section--surface" id="faq">
    <div class="container container--narrow">
      <div class="section-heading">
        <span class="eyebrow-label">Good to know</span>
        <h2>Frequently asked questions</h2>
      </div>
      <div class="accordion" data-accordion>
        <% faqs.forEach(function (f, i) { %>
        <div class="accordion__item">
          <h3 class="accordion__heading">
            <button type="button" class="accordion__trigger" aria-expanded="false" aria-controls="faq-a-<%= i %>" id="faq-q-<%= i %>">
              <%= f.question %><span class="accordion__icon"><%- ic('plus') %></span>
            </button>
          </h3>
          <div class="accordion__panel" id="faq-a-<%= i %>" role="region" aria-labelledby="faq-q-<%= i %>" data-collapsed>
            <p><%= f.answer %></p>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ============ BOOKING ============ -->
  <%# data-bar-yield: the mobile action bar steps aside while this is on
      screen, so it can never cover the wizard's Continue button. %>
  <section class="section" id="appointment" data-bar-yield>
    <div class="container booking-layout">
      <div class="booking-layout__intro">
        <div class="section-heading">
          <span class="eyebrow-label">Book a visit</span>
          <h2>Book an appointment</h2>
          <p class="section-heading__lede">Choose a treatment, pick a date and reserve a time that suits you. The times shown come straight from the clinic's diary.</p>
        </div>
        <div class="booking-layout__fallback">
          <p class="form-label">Prefer to talk to someone?</p>
          <div class="cluster">
            <% if (tel) { %><a class="button button--secondary button--small" href="<%= tel %>" data-track="call_clicked"><%- ic('phone') %>Call <%= clinic.phone %></a><% } %>
            <% if (whatsappUrl) { %><a class="button button--secondary button--small" href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-track="whatsapp_clicked"><%- ic('whatsapp') %>WhatsApp</a><% } %>
            <button type="button" class="button button--text button--small" data-callback-open><%- ic('callback') %>Request a call back</button>
          </div>
        </div>
      </div>

      <div>
        <!-- Booking wizard: rendered and driven by /js/booking.js against the API -->
        <div class="booking" id="bookingShell" aria-labelledby="bookingHeading"
             data-services='<%- servicesJson %>'
             data-tel="<%= tel || '' %>" data-phone="<%= clinic.phone || '' %>" data-whatsapp="<%= whatsappUrl || '' %>">
          <h3 class="visually-hidden-ds" id="bookingHeading">Online booking</h3>
          <div class="booking-progress" id="bookingSteps"></div>
          <p class="visually-hidden-ds" id="bookingStatus" role="status" aria-live="polite"></p>
          <div class="booking__body" id="bookingBody">
            <noscript>
              <p>Online booking needs JavaScript. Please call <strong><%= clinic.phone %></strong> or message the clinic on WhatsApp to book an appointment.</p>
            </noscript>
            <div class="booking__loading"><span class="spinner-ds" aria-hidden="true"></span><span>Loading booking…</span></div>
          </div>
          <div class="booking__foot" id="bookingFoot" hidden>
            <button type="button" class="button button--secondary" id="bookBack">Back</button>
            <button type="button" class="button button--primary" id="bookNext">Continue</button>
          </div>
        </div>

        <%# Self-service on the existing lookup and cancel endpoints. Both need
            the booking reference AND the mobile number it was made with. %>
        <details class="manage" id="manage">
          <summary class="manage__summary">Already booked? Find or cancel your appointment</summary>
          <div class="manage__body">
            <form id="manageForm" data-validate data-validate-js novalidate>
              <p class="visually-hidden-ds" role="status" aria-live="polite" data-form-status></p>
              <div class="manage__fields">
                <div class="form-field">
                  <label class="form-label" for="mgRef">Booking reference</label>
                  <input class="input" id="mgRef" name="ref" autocomplete="off" autocapitalize="characters" spellcheck="false"
                         placeholder="SDC-2026-00001" maxlength="30"
                         data-rule="required" data-error-id="mgRefErr" data-message="Enter the reference from your confirmation." aria-describedby="mgRefErr">
                  <p class="form-error" id="mgRefErr"></p>
                </div>
                <div class="form-field">
                  <label class="form-label" for="mgPhone">Mobile number used to book</label>
                  <input class="input" id="mgPhone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="20"
                         data-rule="mobile" data-error-id="mgPhoneErr" data-message="Enter the 10-digit mobile number you booked with." aria-describedby="mgPhoneErr">
                  <p class="form-error" id="mgPhoneErr"></p>
                </div>
              </div>
              <button type="submit" class="button button--secondary">Find my booking</button>
            </form>
            <div id="manageResult" class="manage__result"></div>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- ============ LOCATION & CONTACT ============ -->
  <section class="section section--sand" id="location">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow-label">Find us</span>
        <h2><%= settings.location_title || 'Visit the clinic' %></h2>
        <% if (settings.location_body) { %><p class="section-heading__lede"><%= settings.location_body %></p><% } %>
      </div>

      <div class="bento bento--3 contact-bento">
        <div class="card contact-bento__address"><div class="card__body">
          <h3 class="card__title"><%- ic('pin') %>Address</h3>
          <address class="contact-bento__lines"><%- addressHtml %></address>
          <div class="card__footer">
            <a class="button button--primary button--small" href="<%= clinic.directions_url %>" target="_blank" rel="noopener" data-track="directions_clicked"><%- ic('directions') %>Get directions</a>
          </div>
          <%- include('partials/social') %>
        </div></div>

        <div class="card"><div class="card__body">
          <h3 class="card__title"><%- ic('phone') %>Call or message</h3>
          <ul class="contact-list">
            <% if (tel) { %><li><a href="<%= tel %>" data-track="call_clicked"><%= clinic.phone %></a><span class="text-small text-muted">Main line<% if (whatsappUrl) { %> and WhatsApp<% } %></span></li><% } %>
            <% if (clinic.phone_secondary) { %><li><a href="tel:<%= clinic.phone_secondary_intl || clinic.phone_secondary %>" data-track="call_clicked"><%= clinic.phone_secondary %></a><span class="text-small text-muted">Second line</span></li><% } %>
          </ul>
          <div class="card__footer">
            <% if (whatsappUrl) { %><a class="button button--secondary button--small" href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-track="whatsapp_clicked"><%- ic('whatsapp') %>WhatsApp</a><% } %>
            <button type="button" class="button button--text button--small" data-callback-open>Request a call back</button>
          </div>
        </div></div>

        <div class="card bento__tall contact-bento__hours"><div class="card__body">
          <h3 class="card__title"><%- ic('clock') %>Opening hours</h3>
          <p class="status-pill status-pill--<%= clinic.today.now.state %>"><span class="status-pill__dot" aria-hidden="true"></span><%= clinic.today.now.label %></p>
          <table class="hours-table-ds">
            <caption class="visually-hidden-ds">Weekly opening hours</caption>
            <tbody>
            <% weekHours.forEach(function (h) { var d = h.display; var isToday = h.weekday === clinic.today.weekdayIndex; %>
              <tr<% if (isToday) { %> class="is-today" aria-current="date"<% } %>>
                <th scope="row"><%= h.day %><% if (isToday) { %> <span class="badge">Today</span><% } %></th>
                <td>
                  <% if (d.closed) { %>Closed<% } else { %>
                    <% d.sessions.forEach(function (sess, i) { %><span class="hours-table-ds__session"><% if (i) { %><span class="visually-hidden-ds">and </span><% } %><%= sess %></span><% }) %>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div></div>

        <div class="card bento__wide contact-bento__map">
          <iframe class="contact-bento__frame" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            data-src="<%= clinic.map_embed_url %>"
            title="Map showing <%= clinic.name %>, <%= shortAddress %>"></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section section--primary cta" id="contact">
    <div class="container cta__inner">
      <span class="eyebrow-label">Ready when you are</span>
      <h2><%= settings.cta_title || 'Book a visit' %></h2>
      <% if (settings.cta_body) { %><p class="cta__body"><%= settings.cta_body %></p><% } %>
      <div class="cluster cta__actions">
        <a href="#appointment" class="button button--inverse" data-track="appointment_started"><%- ic('calendar') %>Book an appointment</a>
        <% if (tel) { %><a href="<%= tel %>" class="button button--text cta__call" data-track="call_clicked"><%- ic('phone') %>Call <%= clinic.phone %></a><% } %>
      </div>
    </div>
  </section>

</main>

<%- include('partials/site-footer') %>

<script src="/js/ds.js" defer></script>
<script src="/js/site-ds.js" defer></script>
<script src="/js/booking.js" defer></script>
</body>
</html>
