<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
<style>
  .preview-banner { padding: var(--space-3) var(--gutter);
    background: var(--color-warning-bg); border-bottom: 2px solid var(--color-warning-text); color: var(--color-text);
    text-align: center; font-size: var(--text-small); }
  .preview-banner strong { color: var(--color-warning-text); }
</style>
</head>
<body class="has-action-bar">
