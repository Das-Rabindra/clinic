<%# Rendered when something has failed — possibly the database — so it needs
    no clinic data at all: tokens and type only. %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<meta name="robots" content="noindex">
<meta name="theme-color" content="#155E59">
<link rel="stylesheet" href="/css/ds.css">
</head>
<body>
<main class="container" style="min-height:70vh; display:grid; place-content:center; text-align:center; padding-block:var(--space-16);">
  <div class="stack" style="max-width:30rem;">
    <h1><%= title %></h1>
    <p class="text-muted"><%= message %></p>
    <p><a href="/" class="button button--primary">Back to the website</a></p>
  </div>
</main>
</body>
</html>
