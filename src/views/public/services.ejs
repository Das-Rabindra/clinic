<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body class="has-action-bar">
<% var ic = function (n) { return include('partials/icon', { name: n }); }; %>
<% var tel = clinic.phone ? 'tel:' + (clinic.phone_intl || clinic.phone) : null; %>
<a class="skip-to-content" href="#main">Skip to content</a>
<%- include('partials/site-header') %>

<main id="main">
  <section class="page-hero">
    <div class="container">
      <%- include('partials/breadcrumbs', { trail: [{ name: 'Home', href: '/' }, { name: 'Treatments' }] }) %>
      <span class="eyebrow-label"><%= settings.treatments_eyebrow || 'Treatments' %></span>
      <h1><%= settings.services_title || 'Dental treatments offered at the clinic' %></h1>
      <% if (settings.services_lede) { %><p class="page-hero__lede"><%= settings.services_lede %></p><% } %>
      <div class="cluster page-hero__actions">
        <a class="button button--primary" href="/#appointment" data-track="appointment_started"><%- ic('calendar') %>Book a consultation</a>
        <% if (tel) { %><a class="button button--secondary" href="<%= tel %>" data-track="call_clicked"><%- ic('phone') %>Call</a><% } %>
        <% if (whatsappUrl) { %><a class="button button--secondary" href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-track="whatsapp_clicked"><%- ic('whatsapp') %>WhatsApp</a><% } %>
      </div>
    </div>
  </section>

  <section class="section section--tight-top" aria-labelledby="allTitle">
    <div class="container">
      <div class="listing-head">
        <h2 id="allTitle">All treatments</h2>
        <p class="text-muted"><%= cards.length %> treatment<%= cards.length === 1 ? '' : 's' %> offered at the clinic</p>
      </div>
      <% if (cards.length) { %>
        <div class="treatment-grid">
          <% cards.forEach(function (s, i) { %>
            <%- include('partials/treatment-card', { s: s, eager: i === 0 }) %>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <h3>Treatments are being updated</h3>
          <p>Please call <% if (tel) { %><a class="link" href="<%= tel %>"><%= clinic.phone %></a><% } %> and the clinic will tell you what is available.</p>
        </div>
      <% } %>
    </div>
  </section>

  <section class="section section--primary cta">
    <div class="container cta__inner">
      <span class="eyebrow-label">Not sure what you need?</span>
      <h2>Start with a consultation</h2>
      <p class="cta__body">Book a consultation and <%= clinic.doctor || 'the dentist' %> will examine your teeth, explain what is going on, and set out the options before any treatment is decided.</p>
      <div class="cluster cta__actions">
        <a href="/#appointment" class="button button--inverse" data-track="appointment_started"><%- ic('calendar') %>Book a consultation</a>
        <button type="button" class="button button--text cta__call" data-callback-open><%- ic('callback') %>Request a call back</button>
      </div>
    </div>
  </section>
</main>

<%- include('partials/site-footer', { navBase: '/' }) %>
<script src="/js/ds.js" defer></script>
<script src="/js/site-ds.js" defer></script>
<script src="/js/motion.js" defer></script>
</body>
</html>
