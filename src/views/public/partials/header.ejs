<%# nav is the anchor prefix: '' on the homepage, '/' everywhere else, so the
    same links work from a treatment page as from the home page. %>
<% var nav = typeof navBase === 'undefined' ? '' : navBase; %>
<header class="site">
  <div class="nav-row">
    <a href="<%= nav || '#top' %>" class="brand">
      <span class="brand-mark"><img src="<%= logoUrl %>" alt="<%= clinic.name %> logo" width="40" height="40"></span>
      <span>
        <span class="brand-name"><%= clinic.name %></span>
        <span class="brand-sub"><%= shortAddress %></span>
      </span>
    </a>
    <nav class="primary" aria-label="Primary">
      <a href="<%= nav %>#about">About</a>
      <a href="/services">Treatments</a>
      <a href="<%= nav %>#gallery">Clinic</a>
      <a href="<%= nav %>#reviews">Testimonials</a>
      <a href="<%= nav %>#faq">FAQ</a>
      <a href="<%= nav %>#location">Contact</a>
    </nav>
    <div class="nav-actions">
      <% if (clinic.phone) { %>
      <a class="nav-call" href="tel:<%= clinic.phone_intl || clinic.phone %>" data-track="call_clicked">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.4 21 3 13.6 3 4.5c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
        <%= clinic.phone %>
      </a>
      <% } %>
      <a href="<%= nav %>#appointment" class="btn btn-primary btn-sm">Book Appointment</a>
      <button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobilePanel">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <nav class="mobile-panel" id="mobilePanel" aria-label="Mobile">
    <a href="<%= nav %>#about">About</a>
    <a href="/services">Treatments</a>
    <a href="<%= nav %>#gallery">Clinic</a>
    <a href="<%= nav %>#reviews">Testimonials</a>
    <a href="<%= nav %>#faq">FAQ</a>
    <a href="<%= nav %>#location">Contact &amp; directions</a>
    <a class="btn btn-primary" href="<%= nav %>#appointment">Book an Appointment</a>
  </nav>
</header>
