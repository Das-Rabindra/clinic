<% var nav = typeof navBase === 'undefined' ? '' : navBase; %>

<%# ── Fixed side rail (tablet and desktop) ──────────────────────────────────
    Three actions a patient may want at any point on the page, without
    scrolling back to the header. Hidden below 900px, where the bottom bar
    takes over, so the two never appear at once. %>
<aside class="action-rail" aria-label="Quick actions">
  <a class="rail-btn rail-book" href="<%= nav %>#appointment" data-track="appointment_started">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 2v4M16 2v4M3.5 9h17M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/></svg>
    <span class="rail-label">Appointment</span>
  </a>
  <button type="button" class="rail-btn rail-call" data-callback-open>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.4 21 3 13.6 3 4.5c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/><path d="M15 3.5a5.5 5.5 0 0 1 5.5 5.5"/></svg>
    <span class="rail-label">Request a call back</span>
  </button>
  <% if (whatsappUrl) { %>
  <a class="rail-btn rail-wa" href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-track="whatsapp_clicked">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.6 1.4 5.1L2 22l5.1-1.3c1.4.8 3.1 1.3 4.9 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2zm5.9 14.2c-.2.7-1.4 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.1.2-.1.3-.3.5-.1.2-.3.4-.4.5-.1.1-.3.3-.1.6.2.3.9 1.5 1.9 2.4 1.3 1.2 2.4 1.5 2.7 1.7.3.2.5.1.7-.1.2-.2.8-.9 1-1.3.2-.3.4-.3.7-.2.3.1 1.8.9 2.1 1 .3.2.5.2.6.3.1.2.1.9-.1 1.6z"/></svg>
    <span class="rail-label">WhatsApp</span>
  </a>
  <% } %>
</aside>

<%# ── Mobile bottom bar ───────────────────────────────────────────────────── %>
<nav class="mobile-bar" aria-label="Quick actions">
  <% if (clinic.phone) { %>
  <a href="tel:<%= clinic.phone_intl || clinic.phone %>" data-track="call_clicked">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.4 21 3 13.6 3 4.5c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
    Call
  </a>
  <% } %>
  <% if (whatsappUrl) { %>
  <a href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-track="whatsapp_clicked">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.6 1.4 5.1L2 22l5.1-1.3c1.4.8 3.1 1.3 4.9 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
    WhatsApp
  </a>
  <% } %>
  <a href="<%= nav %>#appointment" class="bar-book" data-track="appointment_started">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 2v4M16 2v4M3.5 9h17M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/></svg>
    Book Appointment
  </a>
</nav>

<%# ── Call-back request ─────────────────────────────────────────────────────
    Posts to the existing /api/enquiries endpoint, so a request lands in the
    admin Enquiries list exactly like any other — nothing is written to the
    browser and nothing is lost if the patient closes the tab. %>
<div class="modal-backdrop" id="callbackModal" hidden>
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="cbTitle" id="callbackCard">
    <button type="button" class="modal-close" data-callback-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <span class="eyebrow">No obligation</span>
    <h3 id="cbTitle">Request a call back</h3>
    <p class="modal-lede">Leave your number and the clinic will call you back during opening hours. If it is urgent, calling <a class="mono" href="tel:<%= clinic.phone_intl || clinic.phone %>"><%= clinic.phone %></a> is quicker.</p>

    <form id="callbackForm" novalidate>
      <div class="field">
        <label for="cbName">Your name</label>
        <input id="cbName" name="name" type="text" autocomplete="name" required maxlength="120">
        <span class="field-error" data-error-for="name"></span>
      </div>
      <div class="field">
        <label for="cbPhone">Mobile number</label>
        <input id="cbPhone" name="phone" type="tel" inputmode="numeric" autocomplete="tel"
               required maxlength="20" placeholder="10-digit mobile number">
        <span class="field-error" data-error-for="phone"></span>
      </div>
      <div class="field">
        <label for="cbMessage">What would you like to talk about? <span class="field-optional">Optional</span></label>
        <textarea id="cbMessage" name="message" rows="3" maxlength="1000"
                  placeholder="For example: a tooth that has been sensitive for a week"></textarea>
        <span class="field-error" data-error-for="message"></span>
      </div>
      <div class="field">
        <label for="cbWhen">How should we reach you?</label>
        <select id="cbWhen" name="preferred_contact">
          <option value="phone">A phone call</option>
          <option value="whatsapp">A WhatsApp message</option>
        </select>
      </div>
      <p class="form-note">Your number is used only to return this call. Nothing is shared with anyone else — see the <a href="/privacy">privacy note</a>.</p>
      <button type="submit" class="btn btn-primary modal-submit" id="cbSubmit">Request a call back</button>
    </form>

    <div class="modal-done" id="callbackDone" hidden>
      <span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span>
      <h3>Request received</h3>
      <p>The clinic has your number and will call you back during opening hours.</p>
      <button type="button" class="btn btn-outline-dark btn-sm" data-callback-close>Close</button>
    </div>
  </div>
</div>
