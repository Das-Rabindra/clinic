<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= meta.title %></title>
<meta name="description" content="<%= meta.description %>">
<link rel="canonical" href="<%= meta.canonical %>">
<meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'business.business' %>">
<meta property="og:title" content="<%= meta.ogTitle %>">
<meta property="og:description" content="<%= meta.ogDescription %>">
<meta property="og:site_name" content="<%= clinic.name %>">
<meta property="og:locale" content="en_IN">
<meta property="og:url" content="<%= meta.ogUrl %>">
<% if (meta.ogImage) { %><meta property="og:image" content="<%= meta.ogImage %>"><% } %>
<meta name="twitter:card" content="<%= meta.ogImage ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= meta.ogTitle %>">
<meta name="twitter:description" content="<%= meta.ogDescription %>">
<meta name="robots" content="<%= typeof noindex !== 'undefined' && noindex ? 'noindex, follow' : 'index, follow' %>">
<meta name="theme-color" content="#1F3D3A">
<%# Local relevance signals: the town and region the clinic actually serves. %>
<% if (clinic.address_parts && clinic.address_parts.city) { %>
<meta name="geo.placename" content="<%= [clinic.address_parts.area, clinic.address_parts.city].filter(Boolean).join(', ') %>">
<meta name="geo.region" content="IN-OR">
<% } %>
<% if (clinic.latitude && clinic.longitude) { %>
<meta name="geo.position" content="<%= clinic.latitude %>;<%= clinic.longitude %>">
<meta name="ICBM" content="<%= clinic.latitude %>, <%= clinic.longitude %>">
<% } %>
<link rel="icon" type="image/png" href="<%= faviconUrl %>">
<link rel="apple-touch-icon" href="<%= logoUrl %>">
<%# Self-hosted. Loading these from fonts.googleapis.com was the entire cause
    of the site's 0.21 CLS — blocking the font hosts dropped it to exactly 0,
    because the swap to Fraunces changed the header's height and shifted the
    whole page. The two faces used above the fold are preloaded. %>
<link rel="preload" href="/fonts/fraunces-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/site.css">
<%# The hero is the LCP element on desktop and was discovered only when the
    parser reached it. Preloading pulls it forward by roughly a round trip. %>
<% if (typeof preloadImage !== 'undefined' && preloadImage) { %>
<link rel="preload" as="image" href="<%= preloadImage %>" fetchpriority="high">
<% } %>
<%# Marks the document as scripted before first paint, so the FAQ answers can
    be collapsed only where a script exists to reopen them. Without this the
    accordion would hide its own content from anyone browsing without
    JavaScript, and setting the class from site.js (deferred) would flash the
    answers open on every load. %>
<script>document.documentElement.classList.add('js');</script>
<% (typeof schemas !== 'undefined' ? schemas : []).filter(Boolean).forEach(function (s) { %>
<script type="application/ld+json"><%- jsonForScript(s) %></script>
<% }) %>
