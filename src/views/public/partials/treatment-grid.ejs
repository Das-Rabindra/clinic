<%#
  Premium treatment cards. Locals: cards (array of services), navBase.

  The whole card is a link to the treatment page, with the Book button as a
  separate control layered on top — so one tap reaches the detail page and one
  reaches booking, without nesting an interactive element inside another.
%>
<div class="tx-grid">
  <% cards.forEach(function (s, i) { %>
  <article class="tx-card">
    <div class="tx-media<%= s.image_url ? ' has-photo' : '' %>">
      <% if (s.image_url) { %>
        <%# image_url, not the thumb: the thumb is a square crop and this frame
            is 16:9, so the sides would be cut off. %>
        <img src="<%= s.image_url %>"
             alt="<%= s.image_alt || (s.name + ' — illustration') %>"
             width="<%= s.image_width || 1280 %>" height="<%= s.image_height || 720 %>"
             <%# Eager only where the grid really is the first thing on the page.
                 On the homepage it is the fifth section down, so eager-loading
                 the first three fetched ~300KB before anything visible. %>
             loading="<%= (typeof gridIsLead !== 'undefined' && gridIsLead && i < 3) ? 'eager' : 'lazy' %>"
             decoding="async">
      <% } else { %>
        <%- include('treatment-art', { slug: s.slug, name: s.name }) %>
      <% } %>
    </div>

    <div class="tx-body">
      <% if (s.category_name) { %><span class="tx-cat"><%= s.category_name %></span><% } %>
      <h3 class="tx-name">
        <% if (s.has_detail_page) { %>
          <a href="/services/<%= s.slug %>" class="tx-link"><%= s.name %></a>
        <% } else { %><%= s.name %><% } %>
      </h3>
      <% if (s.short_desc) { %><p class="tx-desc"><%= s.short_desc %></p><% } %>

      <div class="tx-foot">
        <% if (s.has_detail_page) { %>
        <span class="tx-more" aria-hidden="true">
          Learn more
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
        </span>
        <% } else { %><span></span><% } %>
        <div class="tx-actions">
          <button type="button" class="tx-callback" data-callback-open
                  data-service="<%= s.id %>" data-service-name="<%= s.name %>"
                  title="Request a call back about <%= s.name %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.4 21 3 13.6 3 4.5c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
            <span class="visually-hidden">Request a call back about <%= s.name %></span>
          </button>
          <% if (s.bookable) { %>
          <button type="button" class="tx-book book-service"
                  data-service="<%= s.id %>" data-service-name="<%= s.name %>"
                  data-track="appointment_started">Book<span class="visually-hidden"> <%= s.name %></span></button>
          <% } %>
        </div>
      </div>
    </div>
  </article>
  <% }) %>
</div>
