<% var nav = typeof navBase === 'undefined' ? '' : navBase; %>
<footer class="site">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-brand">
          <span class="brand-mark" style="background:var(--white);"><img src="<%= logoUrl %>" alt="" width="40" height="40"></span>
          <span class="brand-name"><%= clinic.name %></span>
        </div>
        <p class="foot-about">
          <% if (clinic.doctor) { %><%= clinic.doctor %><% if (clinic.qualification) { %>, <%= clinic.qualification %><% } %><br><% } %>
          <% if (clinic.institution) { %><%= clinic.institution %><br><% } %>
          <% if (clinic.registration) { %><%= clinic.registration %><% } %>
        </p>
        <%- include('social') %>
      </div>

      <div class="foot-col">
        <h4>Treatments</h4>
        <ul>
          <% footerServices.forEach(function (s) { %>
          <li><a href="/services/<%= s.slug %>"><%= s.name %></a></li>
          <% }) %>
          <li><a href="/services">All treatments</a></li>
        </ul>
      </div>

      <div class="foot-col">
        <h4>Clinic</h4>
        <ul>
          <li><a href="<%= nav %>#about">About Dr. <%= (clinic.doctor || '').replace(/^Dr\.?\s*/i, '') %></a></li>
          <li><a href="<%= nav %>#gallery">Inside the clinic</a></li>
          <li><a href="<%= nav %>#reviews">Patient testimonials</a></li>
          <li><a href="<%= nav %>#faq">Questions patients ask</a></li>
          <li><a href="<%= nav %>#appointment">Book an appointment</a></li>
          <li><a href="/privacy">Privacy &amp; appointment policy</a></li>
        </ul>
      </div>

      <div class="foot-col">
        <h4>Visit or contact</h4>
        <ul>
          <li class="foot-address"><%= clinic.address %></li>
          <% if (clinic.phone) { %><li><a class="mono" href="tel:<%= clinic.phone_intl || clinic.phone %>" data-track="call_clicked"><%= clinic.phone %></a></li><% } %>
          <% if (whatsappUrl) { %><li><a href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-track="whatsapp_clicked">WhatsApp the clinic</a></li><% } %>
          <% if (clinic.email) { %><li><a href="mailto:<%= clinic.email %>"><%= clinic.email %></a></li><% } %>
          <li><a href="<%= clinic.directions_url %>" target="_blank" rel="noopener" data-track="directions_clicked">Get directions</a></li>
        </ul>
        <% if (todayHours) { %>
        <p class="foot-hours">
          <span class="open-dot <%= clinic.today.is_open ? 'is-open' : 'is-closed' %>"></span>
          <%= todayHours %>
        </p>
        <% } %>
      </div>
    </div>

    <div class="foot-bottom">
      <span>&copy; <%= new Date().getFullYear() %> <%= clinic.name %>.</span>
      <span>
        <% if (clinic.doctor) { %><%= clinic.doctor %><% } %>
        <% if (clinic.qualification) { %> &middot; <%= clinic.qualification %><% } %>
        <% if (clinic.registration) { %> &middot; <%= clinic.registration %><% } %>
      </span>
    </div>
  </div>
</footer>

<%- include('action-rail') %>
