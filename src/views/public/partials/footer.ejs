<footer class="site">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-brand">
          <span class="brand-mark" style="background:var(--white);"><img src="<%= logoUrl %>" alt="<%= clinic.name %> logo"></span>
          <span class="brand-name"><%= clinic.name %></span>
        </div>
        <p style="font-size:14px; line-height:1.7; max-width:260px; color:rgba(250,248,243,0.65);">
          <% if (clinic.doctor) { %><%= clinic.doctor %><% if (clinic.qualification) { %>, <%= clinic.qualification %><% } %><br><% } %>
          <% if (clinic.institution) { %><%= clinic.institution %><br><% } %>
          <% if (clinic.registration) { %><%= clinic.registration %><% } %>
        </p>
      </div>
      <div class="foot-col">
        <h4>Explore</h4>
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#services">Services</a></li>
          <li><a href="#gallery">Gallery</a></li>
          <li><a href="#reviews">Reviews</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>Contact</h4>
        <ul>
          <% if (clinic.phone) { %><li><a href="tel:<%= clinic.phone_intl || clinic.phone %>"><%= clinic.phone %></a></li><% } %>
          <% if (whatsappUrl) { %><li><a href="<%= whatsappUrl %>" target="_blank" rel="noopener">WhatsApp</a></li><% } %>
          <% if (clinic.email) { %><li><a href="mailto:<%= clinic.email %>"><%= clinic.email %></a></li><% } %>
          <li><a href="#appointment">Book an Appointment</a></li>
          <li><a href="#location">Get Directions</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>Address</h4>
        <ul>
          <li style="color:rgba(250,248,243,0.65); line-height:1.7;"><%= clinic.address %></li>
          <% if (clinic.instagram_url) { %><li><a href="<%= clinic.instagram_url %>" target="_blank" rel="noopener">Instagram</a></li><% } %>
          <% if (clinic.facebook_url) { %><li><a href="<%= clinic.facebook_url %>" target="_blank" rel="noopener">Facebook</a></li><% } %>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; <%= new Date().getFullYear() %> <%= clinic.name %>. All rights reserved.</span>
      <span>
        <% if (clinic.doctor) { %><%= clinic.doctor %><% } %>
        <% if (clinic.qualification) { %> &middot; <%= clinic.qualification %><% } %>
        <% if (clinic.registration) { %> &middot; <%= clinic.registration %><% } %>
      </span>
    </div>
  </div>
</footer>

<nav class="mobile-bar" aria-label="Quick actions">
  <% if (clinic.phone) { %>
  <a href="tel:<%= clinic.phone_intl || clinic.phone %>">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.4 21 3 13.6 3 4.5c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
    Call
  </a>
  <% } %>
  <% if (whatsappUrl) { %>
  <a href="<%= whatsappUrl %>" target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.6 1.4 5.1L2 22l5.1-1.3c1.4.8 3.1 1.3 4.9 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
    WhatsApp
  </a>
  <% } %>
  <a href="#appointment" class="bar-book">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4M16 2v4M3.5 9h17M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/></svg>
    Book Appointment
  </a>
</nav>

<% if (whatsappUrl) { %>
<a class="float-wa" href="<%= whatsappUrl %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.6 1.4 5.1L2 22l5.1-1.3c1.4.8 3.1 1.3 4.9 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2zm5.9 14.2c-.2.7-1.4 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.1.2-.1.3-.3.5-.1.2-.3.4-.4.5-.1.1-.3.3-.1.6.2.3.9 1.5 1.9 2.4 1.3 1.2 2.4 1.5 2.7 1.7.3.2.5.1.7-.1.2-.2.8-.9 1-1.3.2-.3.4-.3.7-.2.3.1 1.8.9 2.1 1 .3.2.5.2.6.3.1.2.1.9-.1 1.6z"/></svg>
</a>
<% } %>
