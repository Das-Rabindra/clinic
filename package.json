{
  "name": "samal-dental-care",
  "version": "1.0.0",
  "private": true,
  "description": "Samal Dental Care — public website, patient booking platform and clinic management system",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "test:watch": "node --test --watch \"test/*.test.mjs\""
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "puppeteer": "^25.10.0"
  }
}
